<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!--
      DataFrame layer for ExcelNet. GraviFrame is the pandas analogue already built by Gravicode
      Studios; ExcelNet adapts it rather than reimplementing it.
      https://github.com/DotNetVibeCoderz/Vibe_ML/tree/main/GravicodeScience
    -->
    <PackageVersion Include="Gravicode.Science.GraviFrame" Version="1.0.0" />
    <PackageVersion Include="Gravicode.Science.GraviNum" Version="1.0.0" />

    <!-- Rasterisation for PDF/document -> image export. -->
    <PackageVersion Include="SkiaSharp" Version="4.151.2" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.151.2" />

    <!-- SQL import/export binds to System.Data.Common; Sqlite is the concrete provider used by
         tests and samples. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />

    <!-- Benchmarking -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!-- Avalonia (OfficeNet.Gallery + desktop editor sample) -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="12.1.1" />
    <!-- Package is Avalonia.AvaloniaEdit but the assembly is AvaloniaEdit; the style include is
         avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- Semantic Kernel. Google and Ollama ship alpha-only; Anthropic has no official connector,
         so Claude is served by a hand-written IChatCompletionService against the Messages API. -->
    <PackageVersion Include="Microsoft.SemanticKernel" Version="1.80.1" />
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.Google" Version="1.80.1-alpha" />

    <!-- Gallery: markdown rendering for chat replies -->
    <PackageVersion Include="Markdig" Version="1.3.2" />
  </ItemGroup>

</Project>
