@page "/master/items"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Authorize(Roles = "Admin,Akuntan,StafGudang")]
@inject AppDbContext DbContext
@inject IJSRuntime JS

<PageTitle>Master Barang - CUAN</PageTitle>

<div class="cu-flex-between cu-mb-2">
    <div><h2 style="margin:0;">📦 Master Barang</h2><span class="cu-text-muted">@totalItems barang terdaftar</span></div>
    <div class="cu-flex cu-gap-1">
        <button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="ExportExcel">📥 Excel</button>
        <button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="ExportCsv">📄 CSV</button>
        <button class="cu-btn cu-btn-primary cu-btn-sm" @onclick="() => ShowModal(null)">+ Barang Baru</button>
    </div>
</div>

<div class="cu-card cu-mb-2">
    <div class="cu-flex cu-gap-2">
        <div style="flex:1;"><input class="cu-form-input" @bind="searchTerm" @bind:event="oninput" placeholder="🔍 Cari kode atau nama barang..." /></div>
        <select class="cu-select" style="width:200px;" @bind="filterCategory">
            <option value="0">Semua Kategori</option>
            @foreach (var cat in categories){<option value="@cat.Id">@cat.Name</option>}
        </select>
        <select class="cu-select" style="width:150px;" @bind="filterStatus">
            <option value="all">Semua Status</option><option value="active">Aktif</option><option value="inactive">Non-Aktif</option><option value="low">Stok Rendah</option>
        </select>
    </div>
</div>

<div class="cu-card"><table class="cu-table"><thead><tr><th>Kode</th><th>Nama Barang</th><th>Kategori</th><th>Harga Beli</th><th>Harga Jual</th><th>Stok</th><th>Status</th><th></th></tr></thead>
<tbody>@foreach (var item in filteredItems){<tr>
<td style="font-family:monospace;font-weight:600;">@item.ItemCode</td><td>@item.ItemName</td><td>@(item.Category?.Name??"-")</td>
<td class="cu-text-right">@item.CostPrice.ToString("N0")</td><td class="cu-text-right">@item.SellingPrice.ToString("N0")</td>
<td class="cu-text-right"><span class="@(item.StockQuantity<=item.MinimumStock?"cu-text-danger":"")" style="font-weight:600;">@item.StockQuantity</span></td>
<td>@if(!item.IsActive){<span class="cu-badge cu-badge-danger">Inactive</span>}else if(item.StockQuantity<=item.MinimumStock){<span class="cu-badge cu-badge-warning">⚠️ Low</span>}else{<span class="cu-badge cu-badge-success">Active</span>}</td>
<td>
    <button class="cu-btn cu-btn-sm cu-btn-outline" @onclick="()=>ShowModal(item)">✏️</button>
    <button class="cu-btn cu-btn-sm cu-btn-danger" title="Hapus" @onclick="()=>DeleteItem(item)">🗑️</button>
</td>
</tr>}</tbody></table></div>

@if(showModal){<div class="cu-modal-overlay" @onclick="HideModal"><div class="cu-modal" style="min-width:500px;" @onclick:stopPropagation="true">
<h3 style="margin-top:0;">@(editingItem.Id==0?"Tambah Barang Baru":"Edit Barang")</h3>
<EditForm Model="editingItem" OnValidSubmit="SaveItem">
<div class="cu-grid cu-grid-2"><div class="cu-form-group"><label class="cu-form-label">Kode *</label><InputText @bind-Value="editingItem.ItemCode" class="cu-form-input"/></div><div class="cu-form-group"><label class="cu-form-label">Nama *</label><InputText @bind-Value="editingItem.ItemName" class="cu-form-input"/></div></div>
<div class="cu-grid cu-grid-2"><div class="cu-form-group"><label class="cu-form-label">Kategori</label><InputSelect @bind-Value="editingItem.CategoryId" class="cu-select"><option value="0">-- Pilih --</option>@foreach(var cat in categories){<option value="@cat.Id">@cat.Name</option>}</InputSelect></div><div class="cu-form-group"><label class="cu-form-label">Satuan</label><InputSelect @bind-Value="editingItem.UnitOfMeasureId" class="cu-select"><option value="0">-- Pilih --</option>@foreach(var uom in units){<option value="@uom.Id">@uom.Name</option>}</InputSelect></div></div>
<div class="cu-grid cu-grid-3"><div class="cu-form-group"><label class="cu-form-label">Harga Beli</label><InputNumber @bind-Value="editingItem.CostPrice" class="cu-form-input"/></div><div class="cu-form-group"><label class="cu-form-label">Harga Jual</label><InputNumber @bind-Value="editingItem.SellingPrice" class="cu-form-input"/></div><div class="cu-form-group"><label class="cu-form-label">Min. Stok</label><InputNumber @bind-Value="editingItem.MinimumStock" class="cu-form-input"/></div></div>
<div class="cu-form-group"><label class="cu-form-label"><input type="checkbox" @bind="editingItem.IsActive" /> Aktif?</label></div>
<div class="cu-flex cu-gap-1" style="justify-content:flex-end;margin-top:1rem;"><button type="button" class="cu-btn cu-btn-outline" @onclick="HideModal">Batal</button><button type="submit" class="cu-btn cu-btn-primary">💾 Simpan</button></div>
</EditForm></div></div>}

@code {
    private List<Item> allItems=new(); private List<ItemCategory> categories=new(); private List<UnitOfMeasure> units=new();
    private string searchTerm=""; private int filterCategory=0; private string filterStatus="all"; private int totalItems;
    private bool showModal; private Item editingItem=new();
    private IEnumerable<Item> filteredItems=>allItems.Where(i=>(filterCategory==0||i.CategoryId==filterCategory)&&(filterStatus switch{"active"=>i.IsActive,"inactive"=>!i.IsActive,"low"=>i.StockQuantity<=i.MinimumStock,_=>true})&&(string.IsNullOrEmpty(searchTerm)||i.ItemCode.Contains(searchTerm,StringComparison.OrdinalIgnoreCase)||i.ItemName.Contains(searchTerm,StringComparison.OrdinalIgnoreCase))).OrderBy(i=>i.ItemCode);
    protected override async Task OnInitializedAsync(){await LoadData();}
    private async Task LoadData(){allItems=await DbContext.Items.Include(i=>i.Category).OrderBy(i=>i.ItemCode).ToListAsync();categories=await DbContext.ItemCategories.OrderBy(c=>c.Name).ToListAsync();units=await DbContext.UnitOfMeasures.OrderBy(u=>u.Name).ToListAsync();totalItems=allItems.Count;}
    private void ShowModal(Item? e){editingItem=e!=null?new Item{Id=e.Id,ItemCode=e.ItemCode,ItemName=e.ItemName,CategoryId=e.CategoryId,UnitOfMeasureId=e.UnitOfMeasureId,Description=e.Description,CostPrice=e.CostPrice,SellingPrice=e.SellingPrice,MinimumStock=e.MinimumStock,IsActive=e.IsActive}:new Item{IsActive=true};showModal=true;}
    private void HideModal(){showModal=false;}
    private async Task SaveItem(){if(editingItem.Id==0){editingItem.CreatedAt=DateTime.UtcNow;DbContext.Items.Add(editingItem);}else{var ex=await DbContext.Items.FindAsync(editingItem.Id);if(ex!=null){ex.ItemCode=editingItem.ItemCode;ex.ItemName=editingItem.ItemName;ex.CategoryId=editingItem.CategoryId;ex.UnitOfMeasureId=editingItem.UnitOfMeasureId;ex.Description=editingItem.Description;ex.CostPrice=editingItem.CostPrice;ex.SellingPrice=editingItem.SellingPrice;ex.MinimumStock=editingItem.MinimumStock;ex.IsActive=editingItem.IsActive;ex.UpdatedAt=DateTime.UtcNow;}}await DbContext.SaveChangesAsync();showModal=false;await LoadData();}

    private async Task DeleteItem(Item item)
    {
        if (!await ConfirmAsync($"Hapus barang {item.ItemCode} - {item.ItemName}?") ) return;
        DbContext.Items.Remove(item);
        await DbContext.SaveChangesAsync();
        await LoadData();
    }

    private async Task ExportCsv()
    {
        var data = filteredItems.Select(i => new
        {
            i.ItemCode,
            i.ItemName,
            Category = i.Category?.Name ?? "-",
            i.CostPrice,
            i.SellingPrice,
            i.StockQuantity,
            i.MinimumStock,
            i.IsActive
        });

        var bytes = ExportService.ExportToCsv(data);
        await DownloadAsync(bytes, "items.csv", "text/csv");
    }

    private async Task ExportExcel()
    {
        var data = filteredItems.Select(i => new
        {
            i.ItemCode,
            i.ItemName,
            Category = i.Category?.Name ?? "-",
            i.CostPrice,
            i.SellingPrice,
            i.StockQuantity,
            i.MinimumStock,
            i.IsActive
        });

        var bytes = ExportService.ExportToExcel(data, "Items");
        await DownloadAsync(bytes, "items.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private async Task DownloadAsync(byte[] data, string fileName, string contentType)
    {
        var base64 = Convert.ToBase64String(data);
        await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, contentType, base64);
    }

    private async Task<bool> ConfirmAsync(string message) =>
        await JS.InvokeAsync<bool>("confirm", message);
}
