@page "/transactions/giro"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Authorize(Roles = "Admin,Akuntan,Kasir")]
@inject AppDbContext DbContext
@inject IJSRuntime JS
<PageTitle>Giro - CUAN</PageTitle>
<div class="cu-flex-between cu-mb-2"><div><h2 style="margin:0;">📜 Giro</h2></div><div class="cu-flex cu-gap-1"><button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="ExportExcel">📥 Excel</button><button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="ExportCsv">📄 CSV</button><button class="cu-btn cu-btn-primary cu-btn-sm" @onclick="CreateNew">+ Giro Baru</button></div></div>

<div class="cu-card cu-mb-2">
    <input class="cu-form-input" @bind="searchTerm" @bind:event="oninput" placeholder="🔍 Cari no, bank, status..." />
</div>

<div class="cu-card"><table class="cu-table"><thead><tr><th>No</th><th>Tgl</th><th>Efektif</th><th>No. Giro</th><th>Bank</th><th class="cu-text-right">Jumlah</th><th>Status</th><th></th></tr></thead>
<tbody>@foreach(var g in filteredGiros){<tr><td style="font-family:monospace;">@g.TransactionNumber</td><td>@g.TransactionDate.ToString("dd/MM/yy")</td><td>@g.EffectiveDate.ToString("dd/MM/yy")</td><td>@g.GiroNumber</td><td>@g.BankName</td><td class="cu-text-right">@g.Amount.ToString("N0")</td><td><span class="cu-badge @(g.Status==GiroStatus.Cleared?"cu-badge-success":g.Status==GiroStatus.Bounced?"cu-badge-danger":"cu-badge-warning")">@g.Status</span></td><td><button class="cu-btn cu-btn-sm cu-btn-outline" @onclick="() => EditTx(g)">✏️</button><button class="cu-btn cu-btn-sm cu-btn-danger" @onclick="() => DeleteTx(g)">🗑️</button></td></tr>}</tbody></table></div>

@if(showCreate){<div class="cu-modal-overlay" @onclick="()=>showCreate=false"><div class="cu-modal" style="min-width:450px;" @onclick:stopPropagation="true"><h3>@(newTx.Id==0?"Giro Baru":"Edit Giro")</h3>
<div class="cu-form-group"><label class="cu-form-label">Tipe</label><select class="cu-select" @bind="newTx.Type"><option value="@GiroType.GiroIn">📥 Giro Masuk</option><option value="@GiroType.GiroOut">📤 Giro Keluar</option></select></div>
<div class="cu-grid cu-grid-2"><div class="cu-form-group"><label class="cu-form-label">Tanggal Terima</label><InputDate @bind-Value="newTx.TransactionDate" class="cu-form-input"/></div><div class="cu-form-group"><label class="cu-form-label">Tanggal Efektif</label><InputDate @bind-Value="newTx.EffectiveDate" class="cu-form-input"/></div></div>
<div class="cu-grid cu-grid-2"><div class="cu-form-group"><label class="cu-form-label">No. Giro</label><InputText @bind-Value="newTx.GiroNumber" class="cu-form-input"/></div><div class="cu-form-group"><label class="cu-form-label">Bank</label><InputText @bind-Value="newTx.BankName" class="cu-form-input"/></div></div>
<div class="cu-grid cu-grid-2"><div class="cu-form-group"><label class="cu-form-label">Jumlah</label><InputNumber @bind-Value="newTx.Amount" class="cu-form-input"/></div><div class="cu-form-group"><label class="cu-form-label">Status</label><select class="cu-select" @bind="newTx.Status"><option value="@GiroStatus.Pending">Pending</option><option value="@GiroStatus.Cleared">Cleared</option><option value="@GiroStatus.Bounced">Bounced</option><option value="@GiroStatus.Canceled">Canceled</option></select></div></div>
<div class="cu-form-group"><label class="cu-form-label">Deskripsi</label><InputText @bind-Value="newTx.Description" class="cu-form-input"/></div>
<div class="cu-flex cu-gap-1" style="justify-content:flex-end;"><button class="cu-btn cu-btn-outline" @onclick="()=>showCreate=false">Batal</button><button class="cu-btn cu-btn-primary" @onclick="SaveTx">💾 Simpan</button></div></div></div>}

@code {
    private List<GiroTransaction> giros=new();
    private bool showCreate;
    private GiroTransaction newTx=new(){TransactionDate=DateTime.Today,EffectiveDate=DateTime.Today.AddDays(30)};
    private string searchTerm = "";

    private IEnumerable<GiroTransaction> filteredGiros => giros
        .Where(g => string.IsNullOrEmpty(searchTerm)
            || g.TransactionNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || g.GiroNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || g.BankName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || g.Status.ToString().Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(g => g.TransactionDate);

    protected override async Task OnInitializedAsync(){await LoadData();}

    private async Task LoadData(){giros=await DbContext.GiroTransactions.OrderByDescending(g=>g.TransactionDate).Take(200).ToListAsync();}

    private void CreateNew(){newTx=new GiroTransaction{TransactionDate=DateTime.Today,EffectiveDate=DateTime.Today.AddDays(30)};showCreate=true;}

    private void EditTx(GiroTransaction tx)
    {
        newTx = new GiroTransaction
        {
            Id = tx.Id,
            TransactionNumber = tx.TransactionNumber,
            TransactionDate = tx.TransactionDate,
            EffectiveDate = tx.EffectiveDate,
            Type = tx.Type,
            GiroNumber = tx.GiroNumber,
            BankName = tx.BankName,
            Amount = tx.Amount,
            Description = tx.Description,
            Status = tx.Status
        };
        showCreate = true;
    }

    private async Task SaveTx(){
        if (newTx.Id == 0)
        {
            newTx.CreatedAt=DateTime.UtcNow;var c=await DbContext.GiroTransactions.CountAsync();newTx.TransactionNumber=$"GIRO-{DateTime.UtcNow.Year}-{c+1:D4}";DbContext.GiroTransactions.Add(newTx);
        }
        else
        {
            DbContext.GiroTransactions.Update(newTx);
        }
        await DbContext.SaveChangesAsync();showCreate=false;await LoadData();}

    private async Task DeleteTx(GiroTransaction tx)
    {
        if (!await ConfirmAsync($"Hapus giro {tx.TransactionNumber}?") ) return;
        DbContext.GiroTransactions.Remove(tx);
        await DbContext.SaveChangesAsync();
        await LoadData();
    }

    private async Task ExportCsv()
    {
        var data = filteredGiros.Select(g => new
        {
            g.TransactionNumber,
            g.TransactionDate,
            g.EffectiveDate,
            g.GiroNumber,
            g.BankName,
            g.Amount,
            g.Status
        });

        var bytes = ExportService.ExportToCsv(data);
        await DownloadAsync(bytes, "giro_transactions.csv", "text/csv");
    }

    private async Task ExportExcel()
    {
        var data = filteredGiros.Select(g => new
        {
            g.TransactionNumber,
            g.TransactionDate,
            g.EffectiveDate,
            g.GiroNumber,
            g.BankName,
            g.Amount,
            g.Status
        });

        var bytes = ExportService.ExportToExcel(data, "GiroTransactions");
        await DownloadAsync(bytes, "giro_transactions.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private async Task DownloadAsync(byte[] data, string fileName, string contentType)
    {
        var base64 = Convert.ToBase64String(data);
        await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, contentType, base64);
    }

    private async Task<bool> ConfirmAsync(string message) =>
        await JS.InvokeAsync<bool>("confirm", message);
}
