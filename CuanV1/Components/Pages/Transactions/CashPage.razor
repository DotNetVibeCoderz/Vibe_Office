@page "/transactions/cash"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Authorize(Roles = "Admin,Akuntan,Kasir")]
@inject AppDbContext DbContext
@inject NotificationService Notif
@inject IJSRuntime JS

<PageTitle>Kas - CUAN</PageTitle>
<div class="cu-flex-between cu-mb-2"><div><h2 style="margin:0;">💵 Transaksi Kas</h2></div><div class="cu-flex cu-gap-1"><button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="ExportExcel">📥 Excel</button><button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="ExportCsv">📄 CSV</button><button class="cu-btn cu-btn-primary cu-btn-sm" @onclick="CreateNew">+ Transaksi Baru</button></div></div>

<div class="cu-card cu-mb-2">
    <input class="cu-form-input" @bind="searchTerm" @bind:event="oninput" placeholder="🔍 Cari no, deskripsi..." />
</div>

<div class="cu-card"><table class="cu-table"><thead><tr><th>No</th><th>Tanggal</th><th>Tipe</th><th>Deskripsi</th><th class="cu-text-right">Jumlah</th><th></th></tr></thead>
<tbody>@foreach(var t in filteredTransactions){<tr><td style="font-family:monospace;">@t.TransactionNumber</td><td>@t.TransactionDate.ToString("dd/MM/yy")</td><td><span class="cu-badge @(t.Type==CashTransactionType.CashIn?"cu-badge-success":"cu-badge-danger")">@t.Type</span></td><td>@t.Description</td><td class="cu-text-right" style="font-weight:600;">@t.Amount.ToString("N0")</td><td><button class="cu-btn cu-btn-sm cu-btn-outline" @onclick="() => EditTx(t)">✏️</button><button class="cu-btn cu-btn-sm cu-btn-danger" @onclick="() => DeleteTx(t)">🗑️</button></td></tr>}</tbody></table></div>

@if(showCreate){<div class="cu-modal-overlay" @onclick="()=>showCreate=false"><div class="cu-modal" style="min-width:450px;" @onclick:stopPropagation="true">
<h3 style="margin-top:0;">@(newTx.Id==0?"Transaksi Kas Baru":"Edit Transaksi Kas")</h3>
<div class="cu-form-group"><label class="cu-form-label">Tipe</label><select class="cu-select" @bind="newTx.Type"><option value="@CashTransactionType.CashIn">💵 Kas Masuk</option><option value="@CashTransactionType.CashOut">💸 Kas Keluar</option></select></div>
<div class="cu-form-group"><label class="cu-form-label">Tanggal</label><InputDate @bind-Value="newTx.TransactionDate" class="cu-form-input"/></div>
<div class="cu-form-group"><label class="cu-form-label">Jumlah</label><InputNumber @bind-Value="newTx.Amount" class="cu-form-input"/></div>
<div class="cu-form-group"><label class="cu-form-label">Deskripsi</label><InputText @bind-Value="newTx.Description" class="cu-form-input"/></div>
<div class="cu-grid cu-grid-2"><div class="cu-form-group"><label class="cu-form-label">Customer (opsional)</label><select class="cu-select" @bind="newTx.CustomerId"><option value="">--</option>@foreach(var c in customers){<option value="@c.Id">@c.Name</option>}</select></div><div class="cu-form-group"><label class="cu-form-label">Supplier (opsional)</label><select class="cu-select" @bind="newTx.SupplierId"><option value="">--</option>@foreach(var s in suppliers){<option value="@s.Id">@s.Name</option>}</select></div></div>
<div class="cu-flex cu-gap-1" style="justify-content:flex-end;margin-top:1rem;"><button class="cu-btn cu-btn-outline" @onclick="()=>showCreate=false">Batal</button><button class="cu-btn cu-btn-primary" @onclick="SaveTransaction">💾 Simpan</button></div></div></div>}

@code {
    private List<CashTransaction> transactions=new();
    private List<Customer> customers=new();
    private List<Supplier> suppliers=new();
    private bool showCreate;
    private CashTransaction newTx=new(){TransactionDate=DateTime.Today};
    private string searchTerm = "";

    private IEnumerable<CashTransaction> filteredTransactions => transactions
        .Where(t => string.IsNullOrEmpty(searchTerm)
            || t.TransactionNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || (t.Description ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(t => t.TransactionDate);

    protected override async Task OnInitializedAsync(){await LoadData();}

    private async Task LoadData()
    {
        transactions=await DbContext.CashTransactions.OrderByDescending(t=>t.TransactionDate).Take(200).ToListAsync();
        customers=await DbContext.Customers.ToListAsync();
        suppliers=await DbContext.Suppliers.ToListAsync();
    }

    private void CreateNew(){newTx=new CashTransaction{TransactionDate=DateTime.Today};showCreate=true;}

    private void EditTx(CashTransaction tx)
    {
        newTx = new CashTransaction
        {
            Id = tx.Id,
            TransactionNumber = tx.TransactionNumber,
            TransactionDate = tx.TransactionDate,
            Type = tx.Type,
            Amount = tx.Amount,
            Description = tx.Description,
            CustomerId = tx.CustomerId,
            SupplierId = tx.SupplierId
        };
        showCreate = true;
    }

    private async Task SaveTransaction(){
        if (newTx.Id == 0)
        {
            newTx.CreatedAt=DateTime.UtcNow;var c=await DbContext.CashTransactions.CountAsync();newTx.TransactionNumber=$"CSH-{DateTime.UtcNow.Year}-{c+1:D4}";DbContext.CashTransactions.Add(newTx);
        }
        else
        {
            DbContext.CashTransactions.Update(newTx);
        }
        await DbContext.SaveChangesAsync();
        await Notif.NotifyAsync("💵 Kas",$"#{newTx.TransactionNumber} — Rp {newTx.Amount:N0}","Info");
        showCreate=false;await LoadData();
    }

    private async Task DeleteTx(CashTransaction tx)
    {
        if (!await ConfirmAsync($"Hapus transaksi {tx.TransactionNumber}?") ) return;
        DbContext.CashTransactions.Remove(tx);
        await DbContext.SaveChangesAsync();
        await LoadData();
    }

    private async Task ExportCsv()
    {
        var data = filteredTransactions.Select(t => new
        {
            t.TransactionNumber,
            t.TransactionDate,
            t.Type,
            t.Amount,
            t.Description
        });

        var bytes = ExportService.ExportToCsv(data);
        await DownloadAsync(bytes, "cash_transactions.csv", "text/csv");
    }

    private async Task ExportExcel()
    {
        var data = filteredTransactions.Select(t => new
        {
            t.TransactionNumber,
            t.TransactionDate,
            t.Type,
            t.Amount,
            t.Description
        });

        var bytes = ExportService.ExportToExcel(data, "CashTransactions");
        await DownloadAsync(bytes, "cash_transactions.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private async Task DownloadAsync(byte[] data, string fileName, string contentType)
    {
        var base64 = Convert.ToBase64String(data);
        await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, contentType, base64);
    }

    private async Task<bool> ConfirmAsync(string message) =>
        await JS.InvokeAsync<bool>("confirm", message);
}
