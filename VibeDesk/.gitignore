# ── build output ────────────────────────────────────────────────────────────
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user
*.suo
.vs/
.idea/

# ── local runtime data ──────────────────────────────────────────────────────
# The dev SQLite database, uploaded files and generated thumbnails. Regenerated by the seeder on a
# fresh run, so committing them only means shipping one machine's demo state to everyone else.
App_Data/
*.db
*.db-shm
*.db-wal

# ── secrets ─────────────────────────────────────────────────────────────────
# Provider keys belong in user secrets or the environment, never in the tree. appsettings.json ships
# with empty key fields on purpose; appsettings.*.local.json is the place to fill them in locally.
testkey.txt
appsettings.*.local.json
secrets.json
*.pfx
*.key

# ── OS noise ────────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
