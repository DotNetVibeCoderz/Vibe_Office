<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:b="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
             xmlns:client="clr-namespace:VibeDesk.Client.Components;assembly=VibeDesk.Client"
             x:Class="VibeDesk.Mobile.MainPage"
             BackgroundColor="#0f5c57">

    <!-- The same root component the desktop host mounts, so the two never drift. -->
    <b:BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <b:BlazorWebView.RootComponents>
            <b:RootComponent Selector="#app" ComponentType="{x:Type client:ClientRoot}" />
        </b:BlazorWebView.RootComponents>
    </b:BlazorWebView>

</ContentPage>
