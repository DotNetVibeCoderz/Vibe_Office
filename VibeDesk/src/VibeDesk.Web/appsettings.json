{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Sqlite": "Data Source=App_Data/vibedesk.db",
    "SqlServer": "Server=localhost;Database=VibeDesk;Trusted_Connection=True;TrustServerCertificate=True",
    "MySql": "Server=localhost;Port=3306;Database=VibeDesk;User=root;Password=changeme",
    "PostgreSql": "Host=localhost;Port=5432;Database=VibeDesk;Username=postgres;Password=changeme"
  },

  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true,
    "SeedSampleData": true,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },

  "Cache": {
    "Provider": "Memory",
    "InstanceName": "vibedesk:",
    "DefaultTtlSeconds": 300,
    "MemorySizeLimit": 8192
  },

  "Storage": {
    "Provider": "FileSystem",
    "RootPath": "App_Data/storage",
    "Bucket": "vibedesk",
    "MaxUploadBytes": 268435456,
    "SignedUrlMinutes": 30,
    "EncryptAtRest": false
  },

  "Assistant": {
    "Provider": "OpenAI",
    "Temperature": 0.4,
    "MaxTokens": 4096,
    "MaxHistoryTurns": 20,
    "MaxToolResultChars": 12000,
    "MaxToolIterations": 6,
    "TimeZoneId": "Asia/Jakarta",
    "SystemPrompt": "You are Mr Clippy, the assistant built into VibeDesk — a workspace with Docs, Sheets, Slides, Drive and Calendar. Help the user finish the task in front of them. Prefer using your tools to read their actual files over guessing. When you change a document, say plainly what you changed. Answer in the user's language. Be concise: this panel is narrow.",

    "OpenAI": {
      "ApiKey": "",
      "Model": "gpt-4o-mini",
      "Models": [ "gpt-4o", "gpt-4o-mini", "gpt-4.1", "gpt-4.1-mini" ]
    },
    "Anthropic": {
      "ApiKey": "",
      "Model": "claude-sonnet-5",
      "Models": [ "claude-opus-5", "claude-sonnet-5", "claude-haiku-4-5-20251001" ]
    },
    "Google": {
      "ApiKey": "",
      "Model": "gemini-2.5-flash",
      "Models": [ "gemini-2.5-pro", "gemini-2.5-flash" ]
    },
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Model": "llama3.2",
      "Models": [ "llama3.2", "qwen2.5", "mistral", "phi4" ]
    },

    "Tavily": {
      "ApiKey": "",
      "Endpoint": "https://api.tavily.com/search",
      "MaxResults": 5
    }
  },

  "Scripting": {
    "Enabled": true,
    "DefaultTimeoutSeconds": 30,
    "MaxTimeoutSeconds": 300,
    "MaxMemoryMb": 96,
    "MaxStatements": 5000000,
    "MaxOutputChars": 64000,
    "MaxRows": 50000,
    "MaxHttpResponseKb": 2048,
    "HttpTimeoutSeconds": 20,
    "MaxHttpCalls": 50,
    "MaxRunsPerScript": 200,
    "SchedulerIntervalSeconds": 30,
    "EnableScheduler": true,
    "MaxEventRunsPerMinute": 60,
    "CSharpAssemblies": []
  },
  "Branding": {
    "Studio": "Gravicode Studios",
    "Lead": "Kang Fadhil"
  }
}
