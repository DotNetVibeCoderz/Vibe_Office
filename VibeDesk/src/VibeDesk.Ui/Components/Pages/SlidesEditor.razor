    private async Task OnGeometryChanged(string key, ChangeEventArgs e)
    {
        if (Selected is null) return;

        if (!double.TryParse(e.Value?.ToString(),
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            return;
        }

        // Clamped so an element can never be positioned entirely off the slide.
        value = Math.Clamp(value, -20, 120);

        switch (key)
        {
            case "x": Selected.X = value; break;
            case "y": Selected.Y = value; break;
            case "w": Selected.W = Math.Max(1, value); break;
            case "h": Selected.H = Math.Max(1, value); break;
        }

        await ScheduleSaveAsync();
    }

    private async Task OnAnimationChanged(ChangeEventArgs e)
    {
        if (Selected is null) return;

        var type = e.Value?.ToString() ?? "none";

        Selected.Animation = type == "none"
            ? null
            : new SlideAnimation { Type = type, Order = Selected.Z };

        await ScheduleSaveAsync();
    }

    private async Task BringForward()
    {
        if (Current is null || Selected is null) return;

        Selected.Z = Current.Elements.Max(el => el.Z) + 1;
        await ScheduleSaveAsync();
    }

    private async Task DeleteElement()
    {
        if (Current is null || Selected is null) return;

        Current.Elements.Remove(Selected);
        _selectedElementId = null;

        await ScheduleSaveAsync();
    }

    // ── presenting ──────────────────────────────────────────────────────────

    private async Task StartPresent()
    {
        SkipHiddenForward();
        _presenting = true;
        _presenterView = false;
        _focusPresent = true;

        await Js.InvokeVoidAsync("vibedesk.requestFullscreen", null);
    }

    private void StartPresenter()
    {
        SkipHiddenForward();
        _presenterView = true;
        _presenting = false;
        _focusPresent = true;
        _presentStarted = DateTimeOffset.UtcNow;

        // The timer only needs to refresh the clock, so a one-second tick is enough.
        _timer?.Dispose();
        _timer = new System.Threading.Timer(
            _ => InvokeAsync(StateHasChanged), null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private async Task StopPresent()
    {
        _presenting = false;
        _presenterView = false;

        _timer?.Dispose();
        _timer = null;

        await Js.InvokeVoidAsync("vibedesk.exitFullscreen");
    }

    private void Next()
    {
        if (_model is null) return;

        var next = _index + 1;
        while (next < _model.Slides.Count && _model.Slides[next].Hidden) next++;

        if (next < _model.Slides.Count) _index = next;
        _selectedElementId = null;
    }

    private void Previous()
    {
        if (_model is null) return;

        var previous = _index - 1;
        while (previous >= 0 && _model.Slides[previous].Hidden) previous--;

        if (previous >= 0) _index = previous;
        _selectedElementId = null;
    }

    /// <summary>Starting on a hidden slide would show something the author chose to skip.</summary>
    private void SkipHiddenForward()
    {
        if (_model is null) return;

        while (_index < _model.Slides.Count && _model.Slides[_index].Hidden) _index++;
        if (_index >= _model.Slides.Count) _index = 0;
    }

    private async Task OnPresentKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowRight":
            case "ArrowDown":
            case " ":
            case "PageDown":
                Next();
                break;

            case "ArrowLeft":
            case "ArrowUp":
            case "PageUp":
                Previous();
                break;

            case "Escape":
                await StopPresent();
                break;

            case "Home":
                _index = 0;
                SkipHiddenForward();
                break;

            case "End":
                if (_model is not null) _index = _model.Slides.Count - 1;
                break;
        }
    }

    // ── persistence ─────────────────────────────────────────────────────────

    private async Task ScheduleSaveAsync()
    {
        _dirty = true;

        _saveDebounce?.Cancel();
        _saveDebounce?.Dispose();
        _saveDebounce = new CancellationTokenSource();
        var token = _saveDebounce.Token;

        try
        {
            await Task.Delay(SaveDelay, token);
            await SaveAsync();
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer edit.
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null || !CanEdit || _saving) return;

        _saving = true;
        StateHasChanged();

        try
        {
            var result = await Content.SaveAsync(Id, ContentJson.Serialize(_model), _revision);

            if (result.Accepted)
            {
                _revision = result.Revision;
                _dirty = false;
            }
            else
            {
                _revision = result.Revision;

                if (result.ServerData is not null)
                {
                    _model = ContentJson.Deserialize<PresentationModel>(result.ServerData);
                    _index = Math.Clamp(_index, 0, Math.Max(0, _model.Slides.Count - 1));
                    _selectedElementId = null;
                    await LoadLinkedSheetsAsync();
                }

                _dirty = false;
                Toasts.Warn("Someone else saved first — this deck has been refreshed with their changes.");
            }
        }
        catch (Exception e)
        {
            Toasts.Error(e);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task OnRename(ChangeEventArgs e)
    {
        var name = e.Value?.ToString()?.Trim();
        if (string.IsNullOrEmpty(name) || name == _item?.Name) return;

        try
        {
            _item = await DriveService.RenameAsync(Id, name);
            Ui.SetContext("slides", Id, _item.Name, DriveItemType.Presentation);
        }
        catch (Exception ex)
        {
            Toasts.Error(ex);
        }
    }

    private async Task SaveVersion()
    {
        try
        {
            if (_dirty) await SaveAsync();
            await Versions.SnapshotAsync(Id, $"Manual save {DateTimeOffset.Now:HH:mm}");
            Toasts.Success("Version saved.");
        }
        catch (Exception e)
        {
            Toasts.Error(e);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // The chart dialog needs a list to choose from; loaded once, not per open.
        try
        {
            var page = await DriveService.QueryAsync(new DriveQuery
            {
                Types = [DriveItemType.Spreadsheet],
                Recursive = true,
                Take = 50,
            });

            _spreadsheets = [.. page.Items];
        }
        catch (Exception)
        {
            _spreadsheets = [];
        }
    }

    public async ValueTask DisposeAsync()
    {
        _saveDebounce?.Cancel();
        _saveDebounce?.Dispose();
        _timer?.Dispose();

        if (_dirty && CanEdit)
        {
            try
            {
                await SaveAsync();
            }
            catch (Exception)
            {
                // Circuit going away.
            }
        }
    }
}
