    /// <summary>Icon key. An unknown key renders the fallback dot rather than throwing.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "circle";

    [Parameter] public int Size { get; set; } = 18;

    /// <summary>Thinner strokes at large sizes keep the optical weight even.</summary>
    [Parameter] public double StrokeWidth { get; set; } = 1.7;

    [Parameter] public string? Class { get; set; }

    /// <summary>Set only when the icon is the sole label for a control; otherwise leave it hidden.</summary>
