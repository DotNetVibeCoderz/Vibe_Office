@*
    Modal dialog. Closes on backdrop click and Escape, and traps nothing — content is expected to
    place its own initial focus, which keeps this component from fighting the caller's autofocus.
*@
@if (Open)
{
    <div class="vd-overlay" @onclick="OnBackdropClick" @onkeydown="OnKeyDown" tabindex="-1">
        <div class="vd-modal @(Wide ? "vd-modal--wide" : "")"
             role="dialog"
             aria-modal="true"
             aria-label="@Title"
             @onclick:stopPropagation="true">

            <div class="vd-modal__head">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <Icon Name="@Icon" Size="20" Class="vd-modal__icon" />
                }
                <h2>@Title</h2>
                <div class="vd-spacer"></div>
                <button type="button" class="vd-btn vd-btn--icon vd-btn--sm"
                        @onclick="Close" aria-label="Close">
                    <Icon Name="close" Size="16" />
                </button>
            </div>

            <div class="vd-modal__body">
                @ChildContent
            </div>

            @if (Footer is not null)
            {
                <div class="vd-modal__foot">
                    @Footer
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Wide { get; set; }

    /// <summary>Set false for dialogs mid-flow where a stray click would lose the user's input.</summary>
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OpenChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
    }

    private async Task OnBackdropClick()
    {
        if (CloseOnBackdrop) await Close();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }
}
