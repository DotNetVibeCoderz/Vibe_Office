<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VibeDesk.Client</RootNamespace>
  </PropertyGroup>

  <!--
    Application and Ui — never Infrastructure. That is the whole point of this project: the desktop
    and mobile hosts get the same contracts the UI is written against, satisfied over HTTP instead of
    EF Core, so no client host drags the ASP.NET Core server framework in with it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\VibeDesk.Application\VibeDesk.Application.csproj" />
    <ProjectReference Include="..\VibeDesk.Domain\VibeDesk.Domain.csproj" />
    <ProjectReference Include="..\VibeDesk.Ui\VibeDesk.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
  </ItemGroup>

</Project>
