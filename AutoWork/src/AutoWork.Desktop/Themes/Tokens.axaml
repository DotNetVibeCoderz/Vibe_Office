<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    AutoWork's design tokens.

    The palette is derived from the product's own anatomy rather than picked for taste: the
    three subsystems — Brain (Think), Eyes (See), Hands (Act) — each own a hue, and every step,
    log line and status marker is tinted by whichever one is responsible. That makes the colour
    carry information instead of decoration. Everything else is a disciplined neutral so those
    three hues stay legible.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <!-- ── Dark ────────────────────────────────────────────────────────────────────────── -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="CanvasColor">#0E1118</Color>
      <SolidColorBrush x:Key="Canvas" Color="#0E1118" />
      <SolidColorBrush x:Key="Surface" Color="#151A24" />
      <SolidColorBrush x:Key="SurfaceRaised" Color="#1D2431" />
      <SolidColorBrush x:Key="SurfaceSunken" Color="#0A0D13" />
      <SolidColorBrush x:Key="Line" Color="#2A3345" />
      <SolidColorBrush x:Key="LineStrong" Color="#3A465C" />

      <SolidColorBrush x:Key="Text" Color="#E8ECF4" />
      <SolidColorBrush x:Key="TextDim" Color="#96A0B5" />
      <SolidColorBrush x:Key="TextFaint" Color="#5F6A80" />

      <SolidColorBrush x:Key="Think" Color="#8A7BFF" />
      <SolidColorBrush x:Key="See" Color="#2BC4C4" />
      <SolidColorBrush x:Key="Act" Color="#F0A052" />

      <SolidColorBrush x:Key="Danger" Color="#FF6B6F" />
      <SolidColorBrush x:Key="Success" Color="#46C46B" />
      <SolidColorBrush x:Key="Warning" Color="#F0B040" />
    </ResourceDictionary>

    <!-- ── Light ───────────────────────────────────────────────────────────────────────── -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="CanvasColor">#F4F6F9</Color>
      <SolidColorBrush x:Key="Canvas" Color="#F4F6F9" />
      <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceRaised" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceSunken" Color="#ECEFF4" />
      <SolidColorBrush x:Key="Line" Color="#DEE3EC" />
      <SolidColorBrush x:Key="LineStrong" Color="#C3CBD9" />

      <SolidColorBrush x:Key="Text" Color="#12151C" />
      <SolidColorBrush x:Key="TextDim" Color="#5B6472" />
      <SolidColorBrush x:Key="TextFaint" Color="#8B94A5" />

      <SolidColorBrush x:Key="Think" Color="#5A47E0" />
      <SolidColorBrush x:Key="See" Color="#0E8F8F" />
      <SolidColorBrush x:Key="Act" Color="#C4761B" />

      <SolidColorBrush x:Key="Danger" Color="#D22C31" />
      <SolidColorBrush x:Key="Success" Color="#1E8E42" />
      <SolidColorBrush x:Key="Warning" Color="#B87A0E" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- ── Shared scale ──────────────────────────────────────────────────────────────────── -->

  <FontFamily x:Key="UiFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

  <!--
    The mono face carries the instrument-panel half of the personality: step stamps, tool
    names, file paths and figures. A system stack keeps it dependency-free and still lands on
    a good face everywhere.
  -->
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, SF Mono, DejaVu Sans Mono, monospace</FontFamily>

  <x:Double x:Key="TextDisplay">28</x:Double>
  <x:Double x:Key="TextTitle">19</x:Double>
  <x:Double x:Key="TextHeading">15</x:Double>
  <x:Double x:Key="TextBody">13.5</x:Double>
  <x:Double x:Key="TextSmall">12</x:Double>
  <x:Double x:Key="TextStamp">11</x:Double>

  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">12</CornerRadius>

  <Thickness x:Key="PadCard">16</Thickness>
  <Thickness x:Key="PadTight">10,7</Thickness>

</ResourceDictionary>
