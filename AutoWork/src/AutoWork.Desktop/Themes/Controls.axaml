<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Control styling. Everything is flat, hairline-bordered and quiet, so the Work Tape and the
    organ hues are the only things asking for attention on any given screen.
  -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Canvas}" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource TextBody}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ── Type roles ───────────────────────────────────────────────────────────────────── -->

  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{DynamicResource TextDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.6" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource TextTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.3" />
  </Style>

  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{DynamicResource TextHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    <Setter Property="FontSize" Value="{DynamicResource TextSmall}" />
  </Style>

  <!-- The eyebrow labels that head each panel: small, spaced, monospaced, quiet. -->
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource TextStamp}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    <Setter Property="LetterSpacing" Value="1.4" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource TextSmall}" />
  </Style>

  <!-- ── Surfaces ─────────────────────────────────────────────────────────────────────── -->

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="Padding" Value="{DynamicResource PadCard}" />
  </Style>

  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Background" Value="{DynamicResource Line}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <!-- A small label beside a title: a category, a state. Sized to the text, never to the row. -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ── Buttons ──────────────────────────────────────────────────────────────────────── -->

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Think}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="18,9" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Think}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
  </Style>

  <!-- ── Inputs ───────────────────────────────────────────────────────────────────────── -->

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CaretBrush" Value="{DynamicResource Think}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Think}" />
  </Style>

  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Think}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <!-- ── Navigation rail ──────────────────────────────────────────────────────────────── -->

  <Style Selector="RadioButton.nav">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Chip"
                Background="Transparent"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="12,9">
          <Grid ColumnDefinitions="3,Auto,*">
            <!-- The active marker is a hairline bar, not a filled pill: it points without shouting. -->
            <Border Name="Marker" Grid.Column="0"
                    Width="3" CornerRadius="2"
                    Background="Transparent" />
            <ContentPresenter Grid.Column="2"
                              Margin="10,0,0,0"
                              Content="{TemplateBinding Content}"
                              VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.nav:pointerover /template/ Border#Chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
  </Style>

  <Style Selector="RadioButton.nav:checked /template/ Border#Chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
  </Style>

  <Style Selector="RadioButton.nav:checked /template/ Border#Marker">
    <Setter Property="Background" Value="{DynamicResource Think}" />
  </Style>

  <Style Selector="RadioButton.nav:checked">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ── Tabs ─────────────────────────────────────────────────────────────────────────── -->
  <!--
    Fluent's default tab headers are display-sized and would out-shout the page title. These
    sit at heading scale with a hairline underline in the Think hue, matching the nav rail's
    marker so "where am I" reads the same way everywhere in the app.
  -->

  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TabControl WrapPanel">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="{DynamicResource TextBody}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="Padding" Value="0,0,0,8" />
    <Setter Property="Margin" Value="0,0,22,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{DynamicResource Think}" />
    <Setter Property="Height" Value="2" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- ── Organ tinting ────────────────────────────────────────────────────────────────── -->
  <!--
    Expressed as classes bound to the row's own organ rather than as a value converter, so a
    theme switch repaints the tape live instead of leaving stale brushes behind.
  -->

  <Style Selector="TextBlock.organ-think"><Setter Property="Foreground" Value="{DynamicResource Think}" /></Style>
  <Style Selector="TextBlock.organ-see"><Setter Property="Foreground" Value="{DynamicResource See}" /></Style>
  <Style Selector="TextBlock.organ-act"><Setter Property="Foreground" Value="{DynamicResource Act}" /></Style>

  <Style Selector="Border.stamp">
    <Setter Property="BorderBrush" Value="{DynamicResource TextFaint}" />
  </Style>
  <Style Selector="Border.stamp.running"><Setter Property="BorderBrush" Value="{DynamicResource Think}" /></Style>
  <Style Selector="Border.stamp.done"><Setter Property="BorderBrush" Value="{DynamicResource Success}" /></Style>
  <Style Selector="Border.stamp.failed"><Setter Property="BorderBrush" Value="{DynamicResource Danger}" /></Style>

  <Style Selector="TextBlock.stampText"><Setter Property="Foreground" Value="{DynamicResource TextFaint}" /></Style>
  <Style Selector="TextBlock.stampText.running"><Setter Property="Foreground" Value="{DynamicResource Think}" /></Style>
  <Style Selector="TextBlock.stampText.done"><Setter Property="Foreground" Value="{DynamicResource Success}" /></Style>
  <Style Selector="TextBlock.stampText.failed"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Style>

  <!-- ── Lists ────────────────────────────────────────────────────────────────────────── -->

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <!-- Respect the OS reduced-motion preference rather than animating regardless. -->
  <Style Selector="Border.pulse">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="INFINITE" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

</Styles>
