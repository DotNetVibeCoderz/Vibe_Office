<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AutoWork.Desktop.ViewModels"
             xmlns:conv="clr-namespace:AutoWork.Desktop.Converters"
             xmlns:log="clr-namespace:AutoWork.Core.Logging;assembly=AutoWork.Core"
             x:Class="AutoWork.Desktop.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">

  <UserControl.Resources>
    <conv:OrganBrushConverter x:Key="Organ" />
    <conv:OutcomeBrushConverter x:Key="Outcome" />
    <conv:TimeConverter x:Key="Time" />
    <conv:JoinConverter x:Key="Join" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*" Margin="26,22,26,0">

    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
      <StackPanel Spacing="3">
        <TextBlock Text="{Binding L[activity.title]}" Classes="title" />
        <TextBlock Text="{Binding L[activity.subtitle]}" Classes="dim" />
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBox Grid.Column="0" Text="{Binding Filter}" Watermark="Filter by tool, summary or path" />
        <Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding L[activity.refresh]}" Command="{Binding LoadCommand}" />
        <Button Grid.Column="2" Margin="8,0,0,0" Content="{Binding L[activity.open]}" Command="{Binding OpenLogFolderCommand}" />
      </Grid>
    </StackPanel>

    <Border Grid.Row="1" Classes="card" Padding="0" Margin="0,0,0,26">
      <Panel>
        <TextBlock Text="{Binding L[activity.empty]}"
                   Classes="dim"
                   Margin="18"
                   IsVisible="{Binding IsEmpty}" />

        <ScrollViewer IsVisible="{Binding !IsEmpty}">
          <ItemsControl ItemsSource="{Binding Entries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="log:ActionLogEntry">
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,11">
                  <Grid ColumnDefinitions="76,4,Auto,*,Auto">

                    <TextBlock Grid.Column="0"
                               Text="{Binding At, Converter={StaticResource Time}}"
                               Classes="mono faint"
                               VerticalAlignment="Center" />

                    <!-- A hairline in the outcome colour: readable at a glance, quiet in bulk. -->
                    <Border Grid.Column="1" Width="3" CornerRadius="2" Margin="0,1"
                            Background="{Binding Outcome, Converter={StaticResource Outcome}}" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding Action}"
                               Classes="mono"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{Binding Organ, Converter={StaticResource Organ}}" />

                    <StackPanel Grid.Column="3" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Summary}" />
                      <TextBlock Text="{Binding Paths, Converter={StaticResource Join}}"
                                 Classes="mono faint"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap" />
                      <TextBlock Text="{Binding Error}"
                                 Classes="mono"
                                 Foreground="{DynamicResource Danger}"
                                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <TextBlock Grid.Column="4"
                               Text="{Binding Outcome}"
                               Classes="mono faint"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </Border>
  </Grid>
</UserControl>
