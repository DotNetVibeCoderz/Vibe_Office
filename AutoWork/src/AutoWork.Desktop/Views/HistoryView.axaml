<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AutoWork.Desktop.ViewModels"
             x:Class="AutoWork.Desktop.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

  <Grid RowDefinitions="Auto,*" Margin="26,22,26,0">

    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="{Binding L[history.title]}" Classes="title" />
          <TextBlock Text="{Binding L[history.subtitle]}" Classes="dim" />
        </StackPanel>

        <Button Grid.Column="1"
                Classes="ghost"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="HistoryRefresh"
                Content="{Binding L[history.refresh]}"
                Command="{Binding ReloadCommand}" />
      </Grid>

      <Border Classes="inset" IsVisible="{Binding HistoryDisabled}">
        <TextBlock Text="{Binding L[history.off]}" Foreground="{DynamicResource Warning}" />
      </Border>
    </StackPanel>

    <Border Grid.Row="1" Classes="card" Padding="0" Margin="0,0,0,26">
      <Panel>
        <StackPanel Margin="18" Spacing="4" IsVisible="{Binding !HasRuns}">
          <TextBlock Text="{Binding L[history.empty]}" Classes="dim" />
          <TextBlock Text="{Binding L[history.empty.hint]}" Classes="faint" />
        </StackPanel>

        <ScrollViewer IsVisible="{Binding HasRuns}">
          <ItemsControl ItemsSource="{Binding Runs}" AutomationProperties.AutomationId="HistoryList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RunHistoryItemViewModel">
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,13">
                  <Grid ColumnDefinitions="96,4,*,Auto">

                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding When}" Classes="mono faint" />
                      <TextBlock Text="{Binding Duration}" Classes="mono faint" />
                    </StackPanel>

                    <!-- A hairline in the outcome colour, the same language the Activity log uses. -->
                    <Panel Grid.Column="1" Margin="0,1">
                      <Border Width="3" CornerRadius="2" Background="{DynamicResource Line}" />
                      <Border Width="3" CornerRadius="2" Background="{DynamicResource Success}" IsVisible="{Binding Succeeded}" />
                      <Border Width="3" CornerRadius="2" Background="{DynamicResource Danger}" IsVisible="{Binding Failed}" />
                    </Panel>

                    <StackPanel Grid.Column="2" Margin="14,0,14,0" Spacing="3">
                      <TextBlock Text="{Binding Goal}"
                                 FontWeight="Medium"
                                 MaxLines="2"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis" />

                      <TextBlock Text="{Binding Summary}"
                                 Classes="dim"
                                 MaxLines="2"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding HasSummary}" />

                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding StatusLabel}" Classes="mono faint"
                                   Foreground="{DynamicResource Success}"
                                   IsVisible="{Binding Succeeded}" />
                        <TextBlock Text="{Binding StatusLabel}" Classes="mono faint"
                                   Foreground="{DynamicResource Danger}"
                                   IsVisible="{Binding Failed}" />
                        <TextBlock Text="{Binding Counts}" Classes="mono faint" />
                        <TextBlock Text="{Binding Tokens}" Classes="mono faint" IsVisible="{Binding HasUsage}" />
                        <TextBlock Text="{Binding Cost}" Classes="mono faint" IsVisible="{Binding HasCost}" />
                        <TextBlock Text="{Binding Model}" Classes="mono faint"
                                   IsVisible="{Binding Model, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="ghost"
                              AutomationProperties.AutomationId="HistoryOpen"
                              Content="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).L[history.open]}"
                              Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).OpenCommand}"
                              CommandParameter="{Binding}" />
                      <Button Classes="ghost"
                              AutomationProperties.AutomationId="HistoryReRun"
                              Content="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).L[history.rerun]}"
                              Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).ReRunCommand}"
                              CommandParameter="{Binding}" />
                      <Button Classes="danger"
                              AutomationProperties.AutomationId="HistoryDelete"
                              Content="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).L[history.delete]}"
                              Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).DeleteCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </Border>
  </Grid>
</UserControl>
