<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Screen capture reads the DIB pixel buffer through a pinned pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoWork.Core\AutoWork.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Search backends stay internal: they are an implementation detail of web_search, but
         their parsers are exactly what needs pinning down with tests. -->
    <InternalsVisibleTo Include="AutoWork.Tests" />
  </ItemGroup>

</Project>
