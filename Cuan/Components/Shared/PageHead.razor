@* Kepala halaman yang seragam: bagian buku besar, judul, keterangan singkat,
   lalu tombol aksi di kanan. *@

<div class="cu-page-head">
    <div>
        @if (!string.IsNullOrEmpty(Section))
        {
            <span class="cu-eyebrow">@Section</span>
        }
        <h1 class="cu-page-title">@Title</h1>
        @if (Subtitle is not null)
        {
            <span class="cu-page-sub">@Subtitle</span>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="cu-page-actions">@Actions</div>
    }
</div>

@code {
    [Parameter] public string? Section { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
