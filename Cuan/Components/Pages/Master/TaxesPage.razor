@page "/master/taxes"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Authorize(Roles = "Admin,Akuntan")]
@inject AppDbContext DbContext
@inject IJSRuntime JS

<PageTitle>Pajak - CUAN</PageTitle>

<div class="cu-flex-between cu-mb-2">
    <div><h2 style="margin:0;">🧾 Pajak</h2><span class="cu-text-muted">@totalTaxes jenis pajak</span></div>
    <div class="cu-flex cu-gap-1">
        <button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="ExportExcel">📥 Excel</button>
        <button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="ExportCsv">📄 CSV</button>
        <button class="cu-btn cu-btn-primary cu-btn-sm" @onclick="() => ShowModal(null)">+ Pajak</button>
    </div>
</div>

<div class="cu-card cu-mb-2">
    <div class="cu-flex cu-gap-2">
        <div style="flex:1;"><input class="cu-form-input" @bind="searchTerm" @bind:event="oninput" placeholder="🔍 Cari kode/nama pajak..." /></div>
    </div>
</div>

<div class="cu-card">
    <table class="cu-table">
        <thead><tr><th>Kode</th><th>Nama</th><th>Tarif (%)</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var t in filteredTaxes)
            {
                <tr>
                    <td><strong>@t.Code</strong></td>
                    <td>@t.Name</td>
                    <td>@t.Rate.ToString("F1")%</td>
                    <td><span class="cu-badge @(t.IsActive ? "cu-badge-success" : "cu-badge-danger")">@(t.IsActive ? "Active" : "Inactive")</span></td>
                    <td>
                        <button class="cu-btn cu-btn-sm cu-btn-outline" @onclick="() => ShowModal(t)">✏️</button>
                        <button class="cu-btn cu-btn-sm cu-btn-danger" title="Hapus" @onclick="() => DeleteTax(t)">🗑️</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (showModal)
{
    <div class="cu-modal-overlay" @onclick="HideModal">
        <div class="cu-modal" @onclick:stopPropagation="true">
            <h3 style="margin-top:0;">@(editingTax.Id == 0 ? "Tambah Pajak" : "Edit Pajak")</h3>
            <EditForm Model="editingTax" OnValidSubmit="SaveTax">
                <div class="cu-grid cu-grid-2">
                    <div class="cu-form-group"><label class="cu-form-label">Kode *</label><InputText @bind-Value="editingTax.Code" class="cu-form-input" /></div>
                    <div class="cu-form-group"><label class="cu-form-label">Nama *</label><InputText @bind-Value="editingTax.Name" class="cu-form-input" /></div>
                </div>
                <div class="cu-grid cu-grid-2">
                    <div class="cu-form-group"><label class="cu-form-label">Tarif (%)</label><InputNumber @bind-Value="editingTax.Rate" class="cu-form-input" /></div>
                    <div class="cu-form-group"><label class="cu-form-label"><input type="checkbox" @bind="editingTax.IsActive" /> Aktif?</label></div>
                </div>
                <div class="cu-flex cu-gap-1" style="justify-content:flex-end;margin-top:1rem;">
                    <button type="button" class="cu-btn cu-btn-outline" @onclick="HideModal">Batal</button>
                    <button type="submit" class="cu-btn cu-btn-primary">💾 Simpan</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<Tax> taxes = new();
    private string searchTerm = "";
    private int totalTaxes;
    private bool showModal;
    private Tax editingTax = new();

    private IEnumerable<Tax> filteredTaxes => taxes
        .Where(t => string.IsNullOrEmpty(searchTerm)
            || t.Code.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || t.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderBy(t => t.Code);

    protected override async Task OnInitializedAsync() { await LoadData(); }
    private async Task LoadData() { taxes = await DbContext.Taxes.OrderBy(t => t.Code).ToListAsync(); totalTaxes = taxes.Count; }

    private void ShowModal(Tax? existing)
    {
        editingTax = existing != null
            ? new Tax { Id = existing.Id, Code = existing.Code, Name = existing.Name, Rate = existing.Rate, IsActive = existing.IsActive }
            : new Tax { IsActive = true };
        showModal = true;
    }

    private void HideModal() { showModal = false; }

    private async Task SaveTax()
    {
        if (editingTax.Id == 0)
        {
            editingTax.CreatedAt = DateTime.UtcNow;
            DbContext.Taxes.Add(editingTax);
        }
        else
        {
            var ex = await DbContext.Taxes.FindAsync(editingTax.Id);
            if (ex != null)
            {
                ex.Code = editingTax.Code;
                ex.Name = editingTax.Name;
                ex.Rate = editingTax.Rate;
                ex.IsActive = editingTax.IsActive;
            }
        }

        await DbContext.SaveChangesAsync();
        showModal = false;
        await LoadData();
    }

    private async Task DeleteTax(Tax tax)
    {
        if (!await ConfirmAsync($"Hapus pajak {tax.Code}?") ) return;
        DbContext.Taxes.Remove(tax);
        await DbContext.SaveChangesAsync();
        await LoadData();
    }

    private async Task ExportCsv()
    {
        var data = filteredTaxes.Select(t => new
        {
            t.Code,
            t.Name,
            t.Rate,
            t.IsActive
        });

        var bytes = ExportService.ExportToCsv(data);
        await DownloadAsync(bytes, "taxes.csv", "text/csv");
    }

    private async Task ExportExcel()
    {
        var data = filteredTaxes.Select(t => new
        {
            t.Code,
            t.Name,
            t.Rate,
            t.IsActive
        });

        var bytes = ExportService.ExportToExcel(data, "Taxes");
        await DownloadAsync(bytes, "taxes.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private async Task DownloadAsync(byte[] data, string fileName, string contentType)
    {
        var base64 = Convert.ToBase64String(data);
        await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, contentType, base64);
    }

    private async Task<bool> ConfirmAsync(string message) =>
        await JS.InvokeAsync<bool>("confirm", message);
}
