@page "/admin/settings"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Authorize(Roles = "Admin")]
@inject AppDbContext DbContext
@inject SettingsService Settings
@inject PostingService Posting
@inject NavigationManager Nav

<PageTitle>Pengaturan — CUAN</PageTitle>

<PageHead Section="Administrasi" Title="Pengaturan"
          Subtitle="@($"{values.Count} parameter · perubahan langsung berlaku tanpa restart")">
    <Actions>
        <button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="Reset" disabled="@(!IsDirty)">
            <Icon Name="refresh" Size="14" /> Batalkan
        </button>
        <button class="cu-btn cu-btn-primary cu-btn-sm" @onclick="Save" disabled="@(!IsDirty || saving)">
            <Icon Name="save" Size="14" /> @(saving ? "Menyimpan…" : $"Simpan {DirtyCount} perubahan")
        </button>
    </Actions>
</PageHead>

@if (message is not null)
{
    <div class="cu-alert @messageClass">@message</div>
}

<div class="cu-tabs">
    @foreach (var group in SettingsCatalog.GroupOrder)
    {
        <button class="cu-tab @(activeGroup == group ? "active" : "")" @onclick="() => activeGroup = group">
            @group
            @if (DirtyInGroup(group) > 0)
            {
                <span class="cu-badge cu-badge-warning" style="margin-left:0.35rem;">@DirtyInGroup(group)</span>
            }
        </button>
    }
</div>

@if (activeGroup == SettingsCatalog.GroupMapping)
{
    <div class="cu-alert cu-alert-info">
        Pemetaan ini menentukan akun mana yang bergerak saat faktur, kas, bank, dan giro diposting.
        Kode yang tidak ditemukan di Daftar Akun akan dilewati, dan jurnalnya menjadi tidak seimbang.
    </div>
}
@if (activeGroup == SettingsCatalog.GroupDjp)
{
    <div class="cu-alert cu-alert-info">
        Akses host-to-host DJP hanya terbuka bagi wajib pajak yang sudah terdaftar dan memegang
        client id, secret, serta sertifikat elektronik. Selama itu belum ada, pelaporan tetap bisa
        ditempuh lewat berkas ekspor di halaman <a href="/tax/faktur">Faktur Pajak</a>.
    </div>
}

<div class="cu-card">
    @foreach (var def in SettingsCatalog.All.Where(d => d.Group == activeGroup))
    {
        <div class="cu-form-group" style="border-bottom:1px solid var(--cu-border);padding-bottom:0.75rem;">
            <div class="cu-grid" style="grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:1rem;align-items:start;">
                <div>
                    <label class="cu-form-label" for="@def.Key" style="font-size:0.8rem;color:var(--cu-text);">
                        @def.Label
                        @if (IsDirtyKey(def.Key))
                        {
                            <span class="cu-badge cu-badge-warning" style="margin-left:0.4rem;">diubah</span>
                        }
                    </label>
                    <div class="cu-mono" style="font-size:0.65rem;color:var(--cu-text-faint);">@def.Key</div>
                    @if (!string.IsNullOrEmpty(def.Description))
                    {
                        <div class="cu-form-hint" style="margin-top:0.25rem;">@def.Description</div>
                    }
                </div>

                <div>
                    @switch (def.Editor)
                    {
                        case SettingEditor.Bool:
                            <label class="cu-switch">
                                <input type="checkbox" id="@def.Key"
                                       checked="@IsOn(def.Key)"
                                       @onchange="e => SetBool(def.Key, e)" />
                                <span class="cu-switch-track"></span>
                                <span class="cu-text-muted">@(IsOn(def.Key) ? "Aktif" : "Nonaktif")</span>
                            </label>
                            break;

                        case SettingEditor.Select:
                            <select id="@def.Key" class="cu-select" value="@values[def.Key]"
                                    @onchange="e => Set(def.Key, e.Value?.ToString() ?? string.Empty)">
                                @foreach (var option in def.Options ?? Array.Empty<string>())
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                            break;

                        case SettingEditor.AccountCode:
                            <select id="@def.Key" class="cu-select" value="@values[def.Key]"
                                    @onchange="e => Set(def.Key, e.Value?.ToString() ?? string.Empty)">
                                <option value="">— belum dipetakan —</option>
                                @foreach (var account in accounts)
                                {
                                    <option value="@account.AccountCode">@account.AccountCode — @account.AccountName</option>
                                }
                            </select>
                            break;

                        case SettingEditor.CurrencyCode:
                            <select id="@def.Key" class="cu-select" value="@values[def.Key]"
                                    @onchange="e => Set(def.Key, e.Value?.ToString() ?? string.Empty)">
                                @foreach (var currency in currencies)
                                {
                                    <option value="@currency.Code">@currency.Code — @currency.Name</option>
                                }
                            </select>
                            break;

                        case SettingEditor.Number:
                            <input id="@def.Key" type="number" step="any" class="cu-form-input cu-num"
                                   value="@values[def.Key]"
                                   @onchange="e => Set(def.Key, e.Value?.ToString() ?? string.Empty)" />
                            break;

                        case SettingEditor.Password:
                            <input id="@def.Key" type="password" class="cu-form-input"
                                   placeholder="belum diisi" autocomplete="new-password"
                                   value="@values[def.Key]"
                                   @onchange="e => Set(def.Key, e.Value?.ToString() ?? string.Empty)" />
                            break;

                        case SettingEditor.Date:
                            <input id="@def.Key" type="date" class="cu-form-input"
                                   value="@values[def.Key]"
                                   @onchange="e => Set(def.Key, e.Value?.ToString() ?? string.Empty)" />
                            break;

                        case SettingEditor.TextArea:
                            <textarea id="@def.Key" class="cu-form-input" rows="2"
                                      value="@values[def.Key]"
                                      @onchange="e => Set(def.Key, e.Value?.ToString() ?? string.Empty)"></textarea>
                            break;

                        default:
                            <input id="@def.Key" class="cu-form-input"
                                   value="@values[def.Key]"
                                   @onchange="e => Set(def.Key, e.Value?.ToString() ?? string.Empty)" />
                            break;
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (activeGroup == SettingsCatalog.GroupAccounting)
{
    <div class="cu-card">
        <div class="cu-card-header"><span class="cu-card-title">Pemeliharaan</span></div>
        <div class="cu-flex-between">
            <div>
                <strong style="font-size:0.85rem;">Hitung ulang saldo seluruh akun</strong>
                <div class="cu-form-hint">
                    Menyusun ulang saldo dari saldo awal ditambah semua jurnal yang sudah diposting.
                    Dipakai setelah impor data atau bila saldo dicurigai melenceng.
                </div>
            </div>
            <button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="Recalculate" disabled="@recalculating">
                <Icon Name="calculator" Size="14" /> @(recalculating ? "Menghitung…" : "Hitung ulang")
            </button>
        </div>
    </div>
}

@code {
    private Dictionary<string, string> values = new();
    private Dictionary<string, string> original = new();
    private List<ChartOfAccount> accounts = new();
    private List<Currency> currencies = new();

    private string activeGroup = SettingsCatalog.GroupCompany;
    private string? message;
    private string messageClass = "cu-alert-success";
    private bool saving, recalculating;

    private bool IsDirty => DirtyCount > 0;
    private int DirtyCount => values.Count(kv => original.GetValueOrDefault(kv.Key) != kv.Value);
    private bool IsDirtyKey(string key) => original.GetValueOrDefault(key) != values.GetValueOrDefault(key);
    private int DirtyInGroup(string group) => SettingsCatalog.All
        .Where(d => d.Group == group).Count(d => IsDirtyKey(d.Key));

    protected override async Task OnInitializedAsync()
    {
        await Settings.EnsureLoadedAsync();

        accounts = await DbContext.ChartOfAccounts
            .Where(a => !a.IsHeader)
            .OrderBy(a => a.AccountCode)
            .ToListAsync();
        currencies = await DbContext.Currencies.OrderBy(c => c.Code).ToListAsync();

        Load();
    }

    private void Load()
    {
        values = SettingsCatalog.All.ToDictionary(d => d.Key, d => Settings.Get(d.Key));
        original = new Dictionary<string, string>(values);
    }

    private bool IsOn(string key) => values.GetValueOrDefault(key) == "true";

    private void Set(string key, string value)
    {
        values[key] = value;
        message = null;
    }

    private void SetBool(string key, ChangeEventArgs e)
        => Set(key, e.Value is true ? "true" : "false");

    private void Reset()
    {
        values = new Dictionary<string, string>(original);
        message = null;
    }

    private async Task Save()
    {
        saving = true;
        try
        {
            var changed = values
                .Where(kv => original.GetValueOrDefault(kv.Key) != kv.Value)
                .ToDictionary(kv => kv.Key, kv => kv.Value);

            await Settings.SaveAsync(changed);
            original = new Dictionary<string, string>(values);

            message = $"{changed.Count} parameter tersimpan dan langsung berlaku.";
            messageClass = "cu-alert-success";
        }
        catch (Exception ex)
        {
            message = $"Gagal menyimpan: {ex.Message}";
            messageClass = "cu-alert-error";
        }
        finally { saving = false; }
    }

    private async Task Recalculate()
    {
        recalculating = true;
        try
        {
            var count = await Posting.RecalculateAllBalancesAsync();
            message = $"Saldo {count} akun dihitung ulang dari jurnal yang sudah diposting.";
            messageClass = "cu-alert-success";
        }
        catch (Exception ex)
        {
            message = $"Gagal menghitung ulang: {ex.Message}";
            messageClass = "cu-alert-error";
        }
        finally { recalculating = false; }
    }
}
