@page "/admin/audit"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Authorize(Roles = "Admin")]
@inject AppDbContext DbContext
@inject IJSRuntime JS

<PageTitle>Audit Trail - CUAN</PageTitle>
<div class="cu-flex-between cu-mb-2"><div><h1 class="cu-page-title">Audit Trail</h1></div></div>

<div class="cu-card cu-mb-2">
    <div class="cu-flex cu-gap-2" style="flex-wrap:wrap;">
        <div style="min-width:160px;">
            <label class="cu-form-label">Tahun</label>
            <select class="cu-select" @bind="selectedYear">
                @foreach (var y in yearOptions){<option value="@y">@y</option>}
            </select>
        </div>
        <div style="min-width:160px;">
            <label class="cu-form-label">Bulan</label>
            <select class="cu-select" @bind="selectedMonth">
                <option value="0">Semua</option>
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i">@(new DateTime(2000, i, 1).ToString("MMMM"))</option>
                }
            </select>
        </div>
        <div style="align-self:end;">
            <button class="cu-btn cu-btn-primary" @onclick="ApplyFilter">Terapkan</button>
        </div>
        <div style="margin-left:auto;align-self:end;">
            <span class="cu-text-muted">Total: @totalCount</span>
        </div>
    </div>
</div>

<div class="cu-card"><div class="cu-table-wrap"><table class="cu-table"><thead><tr><th>Waktu</th><th>User</th><th>Aksi</th><th>Entity</th><th>Deskripsi</th></tr></thead><tbody>@foreach (var a in auditLogs){<tr><td>@a.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@a.UserName</td><td><span class="cu-badge cu-badge-info">@a.Action</span></td><td>@a.EntityName</td><td>@a.Description</td></tr>}</tbody></table></div></div>

<div class="cu-flex cu-gap-1" style="justify-content:flex-end;">
    <button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="PrevPage" disabled="@(pageIndex==1)"><Icon Name="chevron-left" Size="13" /> Sebelumnya</button>
    <span class="cu-text-muted">Page @pageIndex / @totalPages</span>
    <button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="NextPage" disabled="@(pageIndex==totalPages)">Berikutnya <Icon Name="chevron-right" Size="13" /></button>
</div>

@code {
    private List<AuditLog> auditLogs = new();
    private List<int> yearOptions = new();
    private int selectedYear;
    private int selectedMonth;
    private int pageIndex = 1;
    private int pageSize = 20;
    private int totalCount;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));

    protected override async Task OnInitializedAsync()
    {
        yearOptions = await DbContext.AuditLogs.Select(a => a.CreatedAt.Year).Distinct().OrderBy(y => y).ToListAsync();
        if (yearOptions.Count == 0) yearOptions.Add(DateTime.Now.Year);
        selectedYear = yearOptions.Last();
        selectedMonth = 0;
        await LoadData();
    }

    private async Task ApplyFilter()
    {
        pageIndex = 1;
        await LoadData();
    }

    private async Task LoadData()
    {
        var query = DbContext.AuditLogs.AsQueryable();
        query = query.Where(a => a.CreatedAt.Year == selectedYear);
        if (selectedMonth > 0) query = query.Where(a => a.CreatedAt.Month == selectedMonth);

        totalCount = await query.CountAsync();

        auditLogs = await query
            .OrderByDescending(a => a.CreatedAt)
            .Skip((pageIndex - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();
    }

    private async Task PrevPage()
    {
        if (pageIndex <= 1) return;
        pageIndex--;
        await LoadData();
    }

    private async Task NextPage()
    {
        if (pageIndex >= totalPages) return;
        pageIndex++;
        await LoadData();
    }
}
