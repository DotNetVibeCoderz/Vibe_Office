@page "/transactions/sales"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Authorize(Roles = "Admin,Akuntan,Sales")]
@inject AppDbContext DbContext
@inject SettingsService Settings
@inject TaxService Tax
@inject PostingService Posting
@inject DocumentNumberService Numbers
@inject NotificationService Notif
@inject IJSRuntime JS

<PageTitle>Penjualan — CUAN</PageTitle>

<PageHead Section="Transaksi" Title="Penjualan"
          Subtitle="@($"{invoices.Count} faktur · piutang berjalan {Settings.Money(invoices.Sum(i => i.RemainingAmount))}")">
    <Actions>
        <button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="ExportExcel">
            <Icon Name="download" Size="14" /> Excel
        </button>
        <button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="ExportCsv">
            <Icon Name="download" Size="14" /> CSV
        </button>
        <button class="cu-btn cu-btn-primary cu-btn-sm" @onclick="CreateNew">
            <Icon Name="plus" Size="14" /> Faktur baru
        </button>
    </Actions>
</PageHead>

@if (message is not null)
{
    <div class="cu-alert @messageClass">@message</div>
}

<div class="cu-filterbar">
    <div class="cu-search">
        <span class="cu-search-icon"><Icon Name="search" Size="15" /></span>
        <input class="cu-form-input" placeholder="Cari nomor faktur atau pelanggan…" @bind="searchTerm" @bind:event="oninput" />
    </div>
    <select class="cu-select" style="width:170px;" @bind="statusFilter">
        <option value="">Semua status</option>
        <option value="Draft">Draf</option>
        <option value="Confirmed">Dikonfirmasi</option>
        <option value="PartialPaid">Dibayar sebagian</option>
        <option value="Paid">Lunas</option>
    </select>
</div>

<div class="cu-card cu-card-flush" style="margin-bottom:0;">
    @if (!FilteredInvoices().Any())
    {
        <EmptyState Title="Belum ada faktur penjualan"
                    Message="Faktur baru langsung menghitung PPN, membentuk jurnal, dan mengurangi stok barang.">
            <Action>
                <button class="cu-btn cu-btn-primary cu-btn-sm" @onclick="CreateNew">
                    <Icon Name="plus" Size="14" /> Faktur baru
                </button>
            </Action>
        </EmptyState>
    }
    else
    {
        <div class="cu-table-wrap">
            <table class="cu-table">
                <thead>
                    <tr>
                        <th>Nomor</th><th>Tanggal</th><th>Pelanggan</th><th>Jatuh tempo</th>
                        <th class="cu-text-right">Total</th><th class="cu-text-right">Sisa</th>
                        <th>Status</th><th>Jurnal</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in FilteredInvoices())
                    {
                        <tr>
                            <td class="cu-mono">@invoice.InvoiceNumber</td>
                            <td class="cu-mono">@Settings.FormatDate(invoice.InvoiceDate)</td>
                            <td>@invoice.Customer?.Name</td>
                            <td class="cu-mono @(invoice.RemainingAmount > 0 && invoice.DueDate < DateTime.Today ? "cu-text-danger" : "cu-text-faint")">
                                @Settings.FormatDate(invoice.DueDate)
                            </td>
                            <td class="cu-text-right">@Settings.Number(invoice.GrandTotal)</td>
                            <td class="cu-text-right cu-text-credit">@Settings.Number(invoice.RemainingAmount)</td>
                            <td><span class="cu-badge @StatusClass(invoice.Status)">@StatusLabel(invoice.Status)</span></td>
                            <td>
                                @if (invoice.JournalEntryId is not null)
                                {
                                    <span class="cu-badge cu-badge-success">Terjurnal</span>
                                }
                                else
                                {
                                    <span class="cu-badge">—</span>
                                }
                            </td>
                            <td class="cu-text-right">
                                <div class="cu-row-actions">
                                    <button class="cu-btn cu-btn-outline cu-btn-icon" title="Ubah" @onclick="() => EditInvoice(invoice)">
                                        <Icon Name="edit" Size="13" />
                                    </button>
                                    <button class="cu-btn cu-btn-danger cu-btn-icon" title="Hapus" @onclick="() => DeleteInvoice(invoice)">
                                        <Icon Name="trash" Size="13" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr class="cu-total-row">
                        <td colspan="4">Jumlah @FilteredInvoices().Count() faktur</td>
                        <td class="cu-text-right">@Settings.Number(FilteredInvoices().Sum(i => i.GrandTotal))</td>
                        <td class="cu-text-right">@Settings.Number(FilteredInvoices().Sum(i => i.RemainingAmount))</td>
                        <td colspan="3"></td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>

@if (showCreate)
{
    <div class="cu-modal-overlay" @onclick="() => showCreate = false">
        <div class="cu-modal cu-modal-lg" @onclick:stopPropagation="true">
            <div class="cu-modal-head">
                <div>
                    <span class="cu-eyebrow">Transaksi</span>
                    <h3>@(isEditing ? $"Ubah {newInvoice.InvoiceNumber}" : "Faktur penjualan baru")</h3>
                </div>
                <button class="cu-icon-btn" @onclick="() => showCreate = false" aria-label="Tutup">
                    <Icon Name="close" Size="17" />
                </button>
            </div>

            @if (formError is not null)
            {
                <div class="cu-alert cu-alert-error">@formError</div>
            }

            <div class="cu-grid cu-grid-4">
                <div class="cu-form-group">
                    <label class="cu-form-label">Pelanggan</label>
                    <select class="cu-select" @bind="newInvoice.CustomerId">
                        @foreach (var c in customers)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="cu-form-group">
                    <label class="cu-form-label">Tanggal faktur</label>
                    <InputDate @bind-Value="newInvoice.InvoiceDate" class="cu-form-input" />
                </div>
                <div class="cu-form-group">
                    <label class="cu-form-label">Jatuh tempo</label>
                    <InputDate @bind-Value="newInvoice.DueDate" class="cu-form-input" />
                </div>
                <div class="cu-form-group">
                    <label class="cu-form-label">Gudang</label>
                    <select class="cu-select" @bind="newInvoice.WarehouseId">
                        @foreach (var w in warehouses)
                        {
                            <option value="@w.Id">@w.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="cu-table-wrap cu-mb-2">
                <table class="cu-table">
                    <thead>
                        <tr>
                            <th>Barang</th><th class="cu-text-right" style="width:90px;">Qty</th>
                            <th class="cu-text-right" style="width:130px;">Harga</th>
                            <th class="cu-text-right" style="width:90px;">Diskon %</th>
                            <th class="cu-text-right" style="width:130px;">Jumlah</th><th style="width:40px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < newLines.Count; i++)
                        {
                            var line = newLines[i];
                            var index = i;
                            <tr>
                                <td>
                                    <select class="cu-select" @bind="line.ItemId" @bind:after="() => OnItemChanged(line)">
                                        @foreach (var item in items)
                                        {
                                            <option value="@item.Id">@item.ItemName — stok @Settings.Number(item.StockQuantity)</option>
                                        }
                                    </select>
                                </td>
                                <td><InputNumber @bind-Value="line.Quantity" class="cu-form-input cu-num" /></td>
                                <td><InputNumber @bind-Value="line.UnitPrice" class="cu-form-input cu-num" /></td>
                                <td><InputNumber @bind-Value="line.DiscountPercent" class="cu-form-input cu-num" /></td>
                                <td class="cu-text-right" style="font-weight:600;">@Settings.Number(LineTotal(line))</td>
                                <td>
                                    <button class="cu-btn cu-btn-ghost cu-btn-icon" title="Hapus baris"
                                            @onclick="() => RemoveLine(index)">
                                        <Icon Name="close" Size="13" />
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <button class="cu-btn cu-btn-outline cu-btn-sm cu-mb-2" @onclick="AddLine">
                <Icon Name="plus" Size="13" /> Tambah barang
            </button>

            @* Ringkasan nilai faktur. Tarif PPN diambil dari Pengaturan, bukan
               ditanam di halaman ini. *@
            <div class="cu-balance is-balanced">
                <div class="cu-balance-side">
                    <span class="cu-stat-label">Subtotal</span>
                    <span class="cu-balance-fig">@Settings.Number(SubTotal)</span>
                </div>
                <div class="cu-balance-side">
                    <span class="cu-stat-label">
                        @(Tax.PpnEnabled ? $"PPN {Tax.PpnPercent:0.##}%" : "PPN nonaktif")
                    </span>
                    <span class="cu-balance-fig cu-text-credit">@Settings.Number(TaxAmount)</span>
                </div>
                <div class="cu-balance-side">
                    <span class="cu-stat-label">Grand total</span>
                    <span class="cu-balance-fig cu-text-success">@Settings.Money(GrandTotal)</span>
                </div>
            </div>

            <div class="cu-modal-foot">
                <button class="cu-btn cu-btn-outline" @onclick="() => showCreate = false">Batal</button>
                <button class="cu-btn cu-btn-primary" @onclick="SaveInvoice" disabled="@saving">
                    <Icon Name="save" Size="14" /> @(saving ? "Menyimpan…" : "Simpan faktur")
                </button>
            </div>
        </div>
    </div>
}

@code {
    public class LineInv
    {
        public int ItemId { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal DiscountPercent { get; set; }
    }

    private List<SalesInvoice> invoices = new();
    private List<Customer> customers = new();
    private List<Item> items = new();
    private List<Warehouse> warehouses = new();

    private bool showCreate, isEditing, saving;
    private SalesInvoice newInvoice = new();
    private List<LineInv> newLines = new();

    private string searchTerm = "";
    private string statusFilter = "";
    private string? message, formError;
    private string messageClass = "cu-alert-success";

    private static decimal LineTotal(LineInv line)
        => line.Quantity * line.UnitPrice * (1 - line.DiscountPercent / 100);

    private decimal SubTotal => newLines.Sum(LineTotal);
    private decimal TaxAmount => Tax.Compute(SubTotal).Ppn;
    private decimal GrandTotal => SubTotal + TaxAmount;

    protected override async Task OnInitializedAsync()
    {
        await Settings.EnsureLoadedAsync();
        await LoadData();
    }

    private async Task LoadData()
    {
        invoices = await DbContext.SalesInvoices
            .Include(s => s.Customer).Include(s => s.Details)
            .OrderByDescending(s => s.InvoiceDate).ThenByDescending(s => s.Id)
            .Take(200).ToListAsync();
        customers = await DbContext.Customers.Where(c => c.IsActive).OrderBy(c => c.Name).ToListAsync();
        items = await DbContext.Items.Where(i => i.IsActive).OrderBy(i => i.ItemName).ToListAsync();
        warehouses = await DbContext.Warehouses.Where(w => w.IsActive).ToListAsync();
    }

    private IEnumerable<SalesInvoice> FilteredInvoices() => invoices
        .Where(s => string.IsNullOrEmpty(statusFilter) || s.Status.ToString() == statusFilter)
        .Where(s => string.IsNullOrWhiteSpace(searchTerm)
                    || s.InvoiceNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                    || (s.Customer?.Name ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private void CreateNew()
    {
        var termDays = Settings.GetInt(SettingsCatalog.DefaultPaymentTermDays, 30);
        newInvoice = new SalesInvoice
        {
            InvoiceDate = DateTime.Today,
            DueDate = DateTime.Today.AddDays(termDays),
            CustomerId = customers.FirstOrDefault()?.Id ?? 0,
            WarehouseId = warehouses.FirstOrDefault()?.Id,
            ShippingCost = Settings.GetDecimal(SettingsCatalog.DefaultShippingCost, 0)
        };
        newLines = new List<LineInv> { NewLine() };
        formError = null;
        showCreate = true;
        isEditing = false;
    }

    private LineInv NewLine()
    {
        var first = items.FirstOrDefault();
        return new LineInv { ItemId = first?.Id ?? 0, Quantity = 1, UnitPrice = first?.SellingPrice ?? 0 };
    }

    private void OnItemChanged(LineInv line)
    {
        var item = items.FirstOrDefault(i => i.Id == line.ItemId);
        if (item is not null) line.UnitPrice = item.SellingPrice;
    }

    private void EditInvoice(SalesInvoice invoice)
    {
        newInvoice = new SalesInvoice
        {
            Id = invoice.Id,
            InvoiceNumber = invoice.InvoiceNumber,
            InvoiceDate = invoice.InvoiceDate,
            DueDate = invoice.DueDate,
            CustomerId = invoice.CustomerId,
            WarehouseId = invoice.WarehouseId,
            Description = invoice.Description,
            ShippingCost = invoice.ShippingCost,
            Status = invoice.Status
        };

        newLines = invoice.Details.Select(d => new LineInv
        {
            ItemId = d.ItemId,
            Quantity = d.Quantity,
            UnitPrice = d.UnitPrice,
            DiscountPercent = d.DiscountPercent
        }).ToList();

        if (newLines.Count == 0) newLines.Add(NewLine());
        formError = null;
        showCreate = true;
        isEditing = true;
    }

    private void AddLine() => newLines.Add(NewLine());
    private void RemoveLine(int index) { if (newLines.Count > 1) newLines.RemoveAt(index); }

    private List<SalesInvoiceDetail> BuildDetails()
    {
        var rate = Tax.PpnEnabled ? Tax.PpnPercent : 0m;
        return newLines.Where(l => l.Quantity > 0 && l.ItemId > 0).Select(l =>
        {
            var total = LineTotal(l);
            return new SalesInvoiceDetail
            {
                ItemId = l.ItemId,
                Quantity = l.Quantity,
                UnitPrice = l.UnitPrice,
                DiscountPercent = l.DiscountPercent,
                DiscountAmount = l.Quantity * l.UnitPrice * l.DiscountPercent / 100,
                LineTotal = total,
                TaxPercent = rate,
                TaxAmount = Tax.Compute(total).Ppn
            };
        }).ToList();
    }

    private async Task SaveInvoice()
    {
        formError = null;

        if (newInvoice.CustomerId == 0) { formError = "Pilih pelanggan lebih dulu."; return; }

        var details = BuildDetails();
        if (details.Count == 0) { formError = "Tambahkan minimal satu barang dengan kuantitas di atas nol."; return; }

        var maxDiscount = Settings.GetDecimal(SettingsCatalog.MaxSalesDiscountPercent, 100);
        if (newLines.Any(l => l.DiscountPercent > maxDiscount))
        {
            formError = $"Diskon melebihi batas {maxDiscount:0.##}% yang ditetapkan di Pengaturan → Penjualan & Pembelian.";
            return;
        }

        saving = true;
        try
        {
            if (!isEditing)
            {
                newInvoice.InvoiceNumber = await Numbers.NextAsync(DbContext, DocumentKind.SalesInvoice, newInvoice.InvoiceDate);
                newInvoice.SubTotal = SubTotal;
                newInvoice.TaxAmount = TaxAmount;
                newInvoice.GrandTotal = GrandTotal + newInvoice.ShippingCost;
                newInvoice.Details = details;
                newInvoice.Status = InvoiceStatus.Confirmed;
                newInvoice.CreatedAt = DateTime.UtcNow;

                DbContext.SalesInvoices.Add(newInvoice);

                var customer = await DbContext.Customers.FindAsync(newInvoice.CustomerId);
                if (customer is not null) customer.Balance += newInvoice.GrandTotal;

                await DbContext.SaveChangesAsync();

                // Stok keluar lebih dulu: kalau ditolak, faktur dihapus lagi
                // supaya tidak meninggalkan dokumen setengah jadi.
                var stockError = await Posting.ApplySalesStockAsync(newInvoice);
                if (stockError is not null)
                {
                    DbContext.SalesInvoices.Remove(newInvoice);
                    if (customer is not null) customer.Balance -= newInvoice.GrandTotal;
                    await DbContext.SaveChangesAsync();
                    formError = stockError;
                    return;
                }

                await Posting.PostSalesInvoiceAsync(newInvoice);
                Say($"Faktur {newInvoice.InvoiceNumber} tersimpan — {Settings.Money(newInvoice.GrandTotal)}.", true);
                await Notif.NotifyAsync("Penjualan baru",
                    $"Faktur {newInvoice.InvoiceNumber} senilai {Settings.Money(newInvoice.GrandTotal)}",
                    "Info", link: "/transactions/sales");
            }
            else
            {
                var existing = await DbContext.SalesInvoices.Include(s => s.Details)
                    .FirstOrDefaultAsync(s => s.Id == newInvoice.Id);
                if (existing is not null)
                {
                    // Jurnal lama dibatalkan supaya saldo akun tidak dihitung dua kali.
                    await Posting.ReverseDocumentJournalAsync(existing.JournalEntryId);
                    existing.JournalEntryId = null;
                    existing.IsPosted = false;

                    var oldCustomer = await DbContext.Customers.FindAsync(existing.CustomerId);
                    if (oldCustomer is not null) oldCustomer.Balance -= existing.GrandTotal;

                    existing.CustomerId = newInvoice.CustomerId;
                    existing.InvoiceDate = newInvoice.InvoiceDate;
                    existing.DueDate = newInvoice.DueDate;
                    existing.WarehouseId = newInvoice.WarehouseId;
                    existing.ShippingCost = newInvoice.ShippingCost;
                    existing.SubTotal = SubTotal;
                    existing.TaxAmount = TaxAmount;
                    existing.GrandTotal = GrandTotal + newInvoice.ShippingCost;
                    existing.UpdatedAt = DateTime.UtcNow;

                    DbContext.SalesInvoiceDetails.RemoveRange(existing.Details);
                    existing.Details = details;

                    var newCustomer = await DbContext.Customers.FindAsync(existing.CustomerId);
                    if (newCustomer is not null) newCustomer.Balance += existing.GrandTotal;

                    await DbContext.SaveChangesAsync();
                    await Posting.PostSalesInvoiceAsync(existing);
                    Say($"Faktur {existing.InvoiceNumber} diperbarui.", true);
                }
            }

            showCreate = false;
            isEditing = false;
            await LoadData();
        }
        catch (InvalidOperationException ex)
        {
            formError = ex.Message;
        }
        finally { saving = false; }
    }

    private async Task DeleteInvoice(SalesInvoice invoice)
    {
        if (!await JS.InvokeAsync<bool>("cuanConfirm",
            $"Hapus faktur {invoice.InvoiceNumber}? Jurnal yang terbentuk darinya ikut dibatalkan.")) return;

        await Posting.ReverseDocumentJournalAsync(invoice.JournalEntryId);

        var customer = await DbContext.Customers.FindAsync(invoice.CustomerId);
        if (customer is not null) customer.Balance -= invoice.GrandTotal;

        DbContext.SalesInvoices.Remove(invoice);
        await DbContext.SaveChangesAsync();

        Say($"Faktur {invoice.InvoiceNumber} dihapus.", true);
        await LoadData();
    }

    private void Say(string text, bool ok)
    {
        message = text;
        messageClass = ok ? "cu-alert-success" : "cu-alert-warning";
    }

    private static string StatusLabel(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Draft => "Draf",
        InvoiceStatus.Confirmed => "Dikonfirmasi",
        InvoiceStatus.PartialPaid => "Sebagian",
        InvoiceStatus.Paid => "Lunas",
        InvoiceStatus.Canceled => "Batal",
        _ => status.ToString()
    };

    private static string StatusClass(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Paid => "cu-badge-success",
        InvoiceStatus.PartialPaid => "cu-badge-warning",
        InvoiceStatus.Canceled => "cu-badge-danger",
        InvoiceStatus.Draft => "cu-badge-warning",
        _ => "cu-badge-info"
    };

    private async Task ExportCsv()
    {
        var bytes = ExportService.ExportToCsv(ExportRows());
        await Download(bytes, "penjualan.csv", "text/csv");
    }

    private async Task ExportExcel()
    {
        var bytes = ExportService.ExportToExcel(ExportRows(), "Penjualan");
        await Download(bytes, "penjualan.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private List<object> ExportRows() => FilteredInvoices().Select(s => (object)new
    {
        Nomor = s.InvoiceNumber,
        Tanggal = s.InvoiceDate.ToString("yyyy-MM-dd"),
        Pelanggan = s.Customer?.Name,
        JatuhTempo = s.DueDate.ToString("yyyy-MM-dd"),
        Subtotal = s.SubTotal,
        Ppn = s.TaxAmount,
        Total = s.GrandTotal,
        Sisa = s.RemainingAmount,
        Status = StatusLabel(s.Status)
    }).ToList();

    private async Task Download(byte[] data, string fileName, string contentType)
        => await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, contentType, Convert.ToBase64String(data));
}
