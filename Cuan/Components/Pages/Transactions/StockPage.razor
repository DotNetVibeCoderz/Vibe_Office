@page "/transactions/stock"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Authorize(Roles = "Admin,Akuntan,StafGudang")]
@inject AppDbContext DbContext
@inject SettingsService Settings
@inject PostingService Posting
@inject IJSRuntime JS

<PageTitle>Stok — CUAN</PageTitle>

<PageHead Section="Transaksi" Title="Mutasi Stok"
          Subtitle="@($"{movements.Count} mutasi terakhir · penyesuaian langsung mengubah kuantitas barang")">
    <Actions>
        <button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="ExportExcel">
            <Icon Name="download" Size="14" /> Excel
        </button>
        <button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="ExportCsv">
            <Icon Name="download" Size="14" /> CSV
        </button>
        <button class="cu-btn cu-btn-primary cu-btn-sm" @onclick="CreateNew">
            <Icon Name="plus" Size="14" /> Penyesuaian stok
        </button>
    </Actions>
</PageHead>

<div class="cu-filterbar">
    <div class="cu-search">
        <span class="cu-search-icon"><Icon Name="search" Size="15" /></span>
        <input class="cu-form-input" placeholder="Cari barang, gudang, atau jenis mutasi…" @bind="searchTerm" @bind:event="oninput" />
    </div>
</div>

<div class="cu-card cu-card-flush" style="margin-bottom:0;">
    @if (!filteredMovements.Any())
    {
        <EmptyState Title="Belum ada mutasi stok"
                    Message="Penjualan dan pembelian mencatat mutasinya sendiri. Penyesuaian manual dicatat dari sini." />
    }
    else
    {
        <div class="cu-table-wrap">
            <table class="cu-table">
                <thead>
                    <tr>
                        <th>Tanggal</th><th>Barang</th><th>Gudang</th><th>Jenis</th>
                        <th class="cu-text-right cu-col-debit">Masuk</th>
                        <th class="cu-text-right cu-col-credit">Keluar</th>
                        <th class="cu-text-right">Nilai</th><th>Keterangan</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in filteredMovements)
                    {
                        <tr>
                            <td class="cu-mono">@Settings.FormatDate(m.MovementDate)</td>
                            <td>@m.Item?.ItemName</td>
                            <td class="cu-text-faint">@m.Warehouse?.Name</td>
                            <td><span class="cu-badge cu-badge-info">@TypeLabel(m.Type)</span></td>
                            <td class="cu-text-right cu-col-debit">@(m.Quantity > 0 ? Settings.Number(m.Quantity) : "")</td>
                            <td class="cu-text-right cu-col-credit">@(m.Quantity < 0 ? Settings.Number(-m.Quantity) : "")</td>
                            <td class="cu-text-right">@Settings.Number(Math.Abs(m.Quantity * m.UnitCost))</td>
                            <td class="cu-text-muted">@m.Description</td>
                            <td class="cu-text-right">
                                <div class="cu-row-actions">
                                    @if (m.Type == StockMovementType.Adjustment)
                                    {
                                        <button class="cu-btn cu-btn-outline cu-btn-icon" title="Ubah" @onclick="() => EditMovement(m)">
                                            <Icon Name="edit" Size="13" />
                                        </button>
                                        <button class="cu-btn cu-btn-danger cu-btn-icon" title="Hapus" @onclick="() => DeleteMovement(m)">
                                            <Icon Name="trash" Size="13" />
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="cu-text-faint" style="font-size:0.7rem;">dari transaksi</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if(showCreate){<div class="cu-modal-overlay" @onclick="()=>showCreate=false"><div class="cu-modal" style="min-width:450px;" @onclick:stopPropagation="true"><h3 style="margin-top:0;">@(newMov.Id==0?"Penyesuaian stok":"Ubah penyesuaian stok")</h3>
<div class="cu-form-group"><label class="cu-form-label">Barang</label><select class="cu-select" @bind="newMov.ItemId">@foreach(var it in items){<option value="@it.Id">@it.ItemName — stok @Settings.Number(it.StockQuantity)</option>}</select></div>
<div class="cu-form-group"><label class="cu-form-label">Gudang</label><select class="cu-select" @bind="newMov.WarehouseId">@foreach(var w in warehouses){<option value="@w.Id">@w.Name</option>}</select></div>
<div class="cu-grid cu-grid-3"><div class="cu-form-group"><label class="cu-form-label">Tanggal</label><InputDate @bind-Value="newMov.MovementDate" class="cu-form-input"/></div><div class="cu-form-group"><label class="cu-form-label">Selisih (+/−)</label><InputNumber @bind-Value="newMov.Quantity" class="cu-form-input"/></div><div class="cu-form-group"><label class="cu-form-label">Harga pokok</label><InputNumber @bind-Value="newMov.UnitCost" class="cu-form-input"/></div></div>
<div class="cu-form-group"><label class="cu-form-label">Keterangan</label><InputText @bind-Value="newMov.Description" class="cu-form-input"/></div>
<div class="cu-flex cu-gap-1" style="justify-content:flex-end;"><button class="cu-btn cu-btn-outline" @onclick="()=>showCreate=false">Batal</button><button class="cu-btn cu-btn-primary" @onclick="SaveMovement"><Icon Name="save" Size="14" /> Simpan</button></div></div></div>}

@code {
    private List<StockMovement> movements=new();private List<Item> items=new();private List<Warehouse> warehouses=new();private bool showCreate;private StockMovement newMov=new(){MovementDate=DateTime.Today,Type=StockMovementType.Adjustment};
    private string searchTerm = "";

    private IEnumerable<StockMovement> filteredMovements => movements
        .Where(m => string.IsNullOrEmpty(searchTerm)
            || (m.Item?.ItemName ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || (m.Warehouse?.Name ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || m.Type.ToString().Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(m => m.MovementDate);

    protected override async Task OnInitializedAsync(){await Settings.EnsureLoadedAsync();await LoadData();}

    private static string TypeLabel(StockMovementType type) => type switch
    {
        StockMovementType.Purchase => "Pembelian",
        StockMovementType.Sales => "Penjualan",
        StockMovementType.Adjustment => "Penyesuaian",
        StockMovementType.Transfer => "Transfer",
        StockMovementType.Return => "Retur",
        StockMovementType.Opening => "Saldo awal",
        _ => type.ToString()
    };

    private async Task LoadData()
    {
        movements=await DbContext.StockMovements.Include(m=>m.Item).Include(m=>m.Warehouse).OrderByDescending(m=>m.MovementDate).Take(200).ToListAsync();
        items=await DbContext.Items.Where(i=>i.IsActive).ToListAsync();
        warehouses=await DbContext.Warehouses.ToListAsync();
    }

    private void CreateNew(){newMov=new StockMovement{MovementDate=DateTime.Today,Type=StockMovementType.Adjustment};showCreate=true;}

    private void EditMovement(StockMovement mov)
    {
        newMov = new StockMovement
        {
            Id = mov.Id,
            MovementDate = mov.MovementDate,
            ItemId = mov.ItemId,
            WarehouseId = mov.WarehouseId,
            Quantity = mov.Quantity,
            UnitCost = mov.UnitCost,
            Description = mov.Description,
            Type = StockMovementType.Adjustment
        };
        showCreate = true;
    }

    private async Task SaveMovement(){
        if (newMov.Id == 0)
        {
            newMov.CreatedAt = DateTime.UtcNow;
            newMov.Type = StockMovementType.Adjustment;
            DbContext.StockMovements.Add(newMov);

            // Kuantitas barang, stok per gudang, dan jurnal selisihnya diurus
            // PostingService supaya perlakuannya sama dengan mutasi dari faktur.
            await Posting.ApplyStockMovementAsync(newMov);
            await DbContext.SaveChangesAsync();
            await Posting.PostStockAdjustmentAsync(newMov);
        }
        else
        {
            var existing = await DbContext.StockMovements.AsNoTracking().FirstOrDefaultAsync(m => m.Id == newMov.Id);
            if (existing != null)
            {
                // Mutasi lama ditarik kembali sebelum yang baru diterapkan.
                await Posting.ApplyStockMovementAsync(existing, -1);
                await Posting.ApplyStockMovementAsync(newMov);
                DbContext.StockMovements.Update(newMov);
            }
        }

        await DbContext.SaveChangesAsync();
        showCreate=false;await LoadData();
    }

    private async Task DeleteMovement(StockMovement mov)
    {
        if (!await ConfirmAsync("Hapus mutasi stok ini? Kuantitas barang dikembalikan seperti semula.")) return;
        await Posting.ApplyStockMovementAsync(mov, -1);
        DbContext.StockMovements.Remove(mov);
        await DbContext.SaveChangesAsync();
        await LoadData();
    }

    private async Task ExportCsv()
    {
        var data = filteredMovements.Select(m => new
        {
            m.MovementDate,
            Item = m.Item?.ItemName,
            Warehouse = m.Warehouse?.Name,
            m.Type,
            m.Quantity,
            m.Description
        });

        var bytes = ExportService.ExportToCsv(data);
        await DownloadAsync(bytes, "stock_movements.csv", "text/csv");
    }

    private async Task ExportExcel()
    {
        var data = filteredMovements.Select(m => new
        {
            m.MovementDate,
            Item = m.Item?.ItemName,
            Warehouse = m.Warehouse?.Name,
            m.Type,
            m.Quantity,
            m.Description
        });

        var bytes = ExportService.ExportToExcel(data, "StockMovements");
        await DownloadAsync(bytes, "stock_movements.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private async Task DownloadAsync(byte[] data, string fileName, string contentType)
    {
        var base64 = Convert.ToBase64String(data);
        await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, contentType, base64);
    }

    private async Task<bool> ConfirmAsync(string message) =>
        await JS.InvokeAsync<bool>("cuanConfirm", message);
}
