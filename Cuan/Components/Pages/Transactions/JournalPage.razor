@page "/transactions/journal"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Authorize(Roles = "Admin,Akuntan")]
@inject AppDbContext DbContext
@inject IJSRuntime JS

<PageTitle>Jurnal Umum - CUAN</PageTitle>

<div class="cu-flex-between cu-mb-2">
    <div><h2 style="margin:0;">📝 Jurnal Umum</h2><span class="cu-text-muted">@journalCount entri</span></div>
    <div class="cu-flex cu-gap-1">
        <button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="ExportToExcel">📥 Excel</button>
        <button class="cu-btn cu-btn-outline cu-btn-sm" @onclick="ExportToCsv">📄 CSV</button>
        <button class="cu-btn cu-btn-primary cu-btn-sm" @onclick="CreateNew">+ Jurnal Baru</button>
    </div>
</div>

<div class="cu-card cu-mb-2">
    <input class="cu-form-input" @bind="searchTerm" @bind:event="oninput" placeholder="🔍 Cari no, deskripsi, ref..." />
</div>

<div class="cu-card">
    <table class="cu-table">
        <thead><tr><th>No</th><th>Tanggal</th><th>Deskripsi</th><th>Ref</th><th>Sumber</th><th class="cu-text-right">Total</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var j in filteredJournals)
        {
            <tr>
                <td style="font-family:monospace;">@j.JournalNumber</td>
                <td>@j.TransactionDate.ToString("dd/MM/yyyy")</td>
                <td>@j.Description</td><td>@j.Reference</td>
                <td><span class="cu-badge cu-badge-info">@j.SourceType</span></td>
                <td class="cu-text-right">@j.Details.Sum(d=>d.Debit).ToString("N0")</td>
                <td><span class="cu-badge @(j.IsPosted?"cu-badge-success":"cu-badge-warning")">@(j.IsPosted?"Posted":"Draft")</span></td>
                <td>
                    <button class="cu-btn cu-btn-sm cu-btn-outline" @onclick="()=>ViewJournal(j)">👁️</button>
                    <button class="cu-btn cu-btn-sm cu-btn-outline" @onclick="()=>EditJournal(j)">✏️</button>
                    <button class="cu-btn cu-btn-sm cu-btn-danger" @onclick="()=>DeleteJournal(j)">🗑️</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (showCreate)
{
    <div class="cu-modal-overlay" @onclick="()=>showCreate=false"><div class="cu-modal" style="min-width:650px;" @onclick:stopPropagation="true">
        <h3 style="margin-top:0;">@(isEditing?"Edit Jurnal":"Jurnal Baru")</h3>
        <div class="cu-grid cu-grid-2">
            <div class="cu-form-group"><label class="cu-form-label">Tanggal</label><InputDate @bind-Value="newJournal.TransactionDate" class="cu-form-input" /></div>
            <div class="cu-form-group"><label class="cu-form-label">Referensi</label><InputText @bind-Value="newJournal.Reference" class="cu-form-input" /></div>
        </div>
        <div class="cu-form-group"><label class="cu-form-label">Deskripsi</label><InputText @bind-Value="newJournal.Description" class="cu-form-input" /></div>
        <table class="cu-table" style="margin-bottom:1rem;">
            <thead><tr><th>Akun</th><th>Deskripsi</th><th class="cu-text-right">Debit</th><th class="cu-text-right">Kredit</th><th></th></tr></thead>
            <tbody>
            @for (int i = 0; i < newLines.Count; i++)
            {
                var line = newLines[i]; var idx = i;
                <tr>
                    <td style="min-width:200px;"><select class="cu-select" @bind="line.ChartOfAccountId" style="font-size:0.75rem;">
                        <option value="0">-- Pilih Akun --</option>
                        @foreach (var c in coaList.Where(x=>!x.IsHeader)){<option value="@c.Id">@c.AccountCode - @c.AccountName</option>}
                    </select></td>
                    <td><input class="cu-form-input" @bind="line.Description" style="font-size:0.75rem;" /></td>
                    <td style="width:120px;"><InputNumber @bind-Value="line.Debit" class="cu-form-input" style="font-size:0.75rem;" /></td>
                    <td style="width:120px;"><InputNumber @bind-Value="line.Credit" class="cu-form-input" style="font-size:0.75rem;" /></td>
                    <td><button class="cu-btn cu-btn-sm cu-btn-danger" @onclick="()=>RemoveLine(idx)">✕</button></td>
                </tr>
            }
            </tbody>
        </table>
        <button class="cu-btn cu-btn-sm cu-btn-outline" @onclick="AddLine">+ Tambah Baris</button>
        <div class="cu-mb-1"></div>
        <div class="cu-flex cu-gap-1" style="justify-content:space-between;">
            <div><span class="cu-text-muted">Debit: <strong>@newLines.Sum(l=>l.Debit).ToString("N0")</strong></span> | <span class="cu-text-muted">Kredit: <strong>@newLines.Sum(l=>l.Credit).ToString("N0")</strong></span> <span class="@(newLines.Sum(l=>l.Debit)==newLines.Sum(l=>l.Credit)?"cu-text-success":"cu-text-danger")">@(newLines.Sum(l=>l.Debit)==newLines.Sum(l=>l.Credit)?"✅ Balance":"❌ Tidak balance")</span></div>
            <div class="cu-flex cu-gap-1">
                <button class="cu-btn cu-btn-outline" @onclick="()=>showCreate=false">Batal</button>
                <button class="cu-btn cu-btn-primary" @onclick="SaveJournal">💾 Simpan</button>
            </div>
        </div>
    </div></div>
}

@if (viewJournal != null)
{
    <div class="cu-modal-overlay" @onclick="()=>viewJournal=null"><div class="cu-modal" style="min-width:500px;" @onclick:stopPropagation="true">
        <h3 style="margin-top:0;">📄 @viewJournal.JournalNumber</h3>
        <p>@viewJournal.Description | @viewJournal.TransactionDate.ToString("dd MMM yyyy")</p>
        <table class="cu-table"><thead><tr><th>Akun</th><th>Deskripsi</th><th class="cu-text-right">Debit</th><th class="cu-text-right">Kredit</th></tr></thead>
        <tbody>@foreach (var d in viewJournal.Details){<tr><td>@d.ChartOfAccount?.AccountCode - @d.ChartOfAccount?.AccountName</td><td>@d.Description</td><td class="cu-text-right">@d.Debit.ToString("N0")</td><td class="cu-text-right">@d.Credit.ToString("N0")</td></tr>}</tbody></table>
        <button class="cu-btn cu-btn-outline" @onclick="()=>viewJournal=null" style="margin-top:1rem;">Tutup</button>
    </div></div>
}

@code {
    private List<JournalEntry> journals = new();
    private List<ChartOfAccount> coaList = new();
    private int journalCount;
    private bool showCreate;
    private bool isEditing;
    private string searchTerm = "";
    private JournalEntry? viewJournal;
    private JournalEntry newJournal = new(){TransactionDate=DateTime.Today};
    private List<LineItem> newLines = new(){new()};

    public class LineItem{public int ChartOfAccountId;public string Description="";public decimal Debit;public decimal Credit;}

    private IEnumerable<JournalEntry> filteredJournals => journals
        .Where(j => string.IsNullOrEmpty(searchTerm)
            || j.JournalNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || (j.Description ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || (j.Reference ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(j => j.TransactionDate);

    protected override async Task OnInitializedAsync(){await LoadData();}
    private async Task LoadData(){journals=await DbContext.JournalEntries.Include(j=>j.Details).ThenInclude(d=>d.ChartOfAccount).OrderByDescending(j=>j.TransactionDate).Take(200).ToListAsync();coaList=await DbContext.ChartOfAccounts.OrderBy(c=>c.AccountCode).ToListAsync();journalCount=await DbContext.JournalEntries.CountAsync();}
    private void CreateNew(){newJournal=new JournalEntry{TransactionDate=DateTime.Today};newLines=new List<LineItem>{new()};showCreate=true;isEditing=false;}
    private void AddLine(){newLines.Add(new LineItem());}
    private void RemoveLine(int i){if(newLines.Count>1)newLines.RemoveAt(i);}
    private void ViewJournal(JournalEntry j){viewJournal=j;}

    private async Task EditJournal(JournalEntry j)
    {
        newJournal = new JournalEntry
        {
            Id = j.Id,
            JournalNumber = j.JournalNumber,
            TransactionDate = j.TransactionDate,
            Reference = j.Reference,
            Description = j.Description,
            SourceType = j.SourceType,
            IsPosted = j.IsPosted
        };

        newLines = j.Details.Select(d => new LineItem
        {
            ChartOfAccountId = d.ChartOfAccountId,
            Description = d.Description ?? "",
            Debit = d.Debit,
            Credit = d.Credit
        }).ToList();

        if (newLines.Count == 0) newLines.Add(new LineItem());
        isEditing = true;
        showCreate = true;
    }

    private async Task SaveJournal(){
        if(newLines.Sum(l=>l.Debit)!=newLines.Sum(l=>l.Credit)||newLines.Sum(l=>l.Debit)==0)return;

        if (!isEditing)
        {
            newJournal.CreatedAt=DateTime.UtcNow;
            newJournal.JournalNumber=$"JU-{DateTime.UtcNow.Year}-{journalCount+1:D4}";
            newJournal.Details=newLines.Where(l=>l.ChartOfAccountId>0&&(l.Debit>0||l.Credit>0)).Select(l=>new JournalEntryDetail{ChartOfAccountId=l.ChartOfAccountId,Description=l.Description,Debit=l.Debit,Credit=l.Credit}).ToList();
            DbContext.JournalEntries.Add(newJournal);
        }
        else
        {
            var existing = await DbContext.JournalEntries.Include(x => x.Details).FirstOrDefaultAsync(x => x.Id == newJournal.Id);
            if (existing != null)
            {
                existing.TransactionDate = newJournal.TransactionDate;
                existing.Reference = newJournal.Reference;
                existing.Description = newJournal.Description;
                existing.SourceType = newJournal.SourceType;
                DbContext.JournalEntryDetails.RemoveRange(existing.Details);
                existing.Details = newLines.Where(l=>l.ChartOfAccountId>0&&(l.Debit>0||l.Credit>0)).Select(l=>new JournalEntryDetail{ChartOfAccountId=l.ChartOfAccountId,Description=l.Description,Debit=l.Debit,Credit=l.Credit}).ToList();
            }
        }

        await DbContext.SaveChangesAsync();
        showCreate=false;isEditing=false;await LoadData();
    }

    private async Task DeleteJournal(JournalEntry j)
    {
        if (!await ConfirmAsync($"Hapus jurnal {j.JournalNumber}?") ) return;
        DbContext.JournalEntries.Remove(j);
        await DbContext.SaveChangesAsync();
        await LoadData();
    }

    private async Task ExportToExcel()
    {
        var data = filteredJournals.Select(j => new
        {
            j.JournalNumber,
            j.TransactionDate,
            j.Description,
            j.Reference,
            j.SourceType,
            Total = j.Details.Sum(d => d.Debit),
            j.IsPosted
        });

        var bytes = ExportService.ExportToExcel(data, "Journals");
        await DownloadAsync(bytes, "journals.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private async Task ExportToCsv()
    {
        var data = filteredJournals.Select(j => new
        {
            j.JournalNumber,
            j.TransactionDate,
            j.Description,
            j.Reference,
            j.SourceType,
            Total = j.Details.Sum(d => d.Debit),
            j.IsPosted
        });

        var bytes = ExportService.ExportToCsv(data);
        await DownloadAsync(bytes, "journals.csv", "text/csv");
    }

    private async Task DownloadAsync(byte[] data, string fileName, string contentType)
    {
        var base64 = Convert.ToBase64String(data);
        await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, contentType, base64);
    }

    private async Task<bool> ConfirmAsync(string message) =>
        await JS.InvokeAsync<bool>("confirm", message);
}
